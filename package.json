    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.5.0",
    "astro": "^5.0.0",
    "lucide-astro": "^0.470.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "wrangler": "^4.59.2"
