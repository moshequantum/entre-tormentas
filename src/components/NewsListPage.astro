---
import Layout from '../layouts/Layout.astro';
import Pagination from './Pagination.astro';
import { getSortedPostsCached } from '../lib/posts-cache';

const sortedPosts = await getSortedPostsCached();

function formatEditorialDate(value?: string | Date): string {
  if (!value) return 'Reciente';
  const parsed = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(parsed.getTime())) return String(value);
  return new Intl.DateTimeFormat('es-VE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(parsed);
}

function resolveExcerpt(excerpt?: string, body?: string): string {
  if (excerpt && excerpt.trim()) return excerpt.trim();
  if (body && body.trim()) {
    const clean = body
      .replace(/!\[.*?\]\(.*?\)/g, '')
      .replace(/[#*_>`~\\]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
    if (clean) return clean.length > 160 ? `${clean.slice(0, 160).trim()}…` : clean;
  }
  return 'Noticias de actualidad y sucesos en el Zulia y Venezuela.';
}

const { currentPage = 1 } = Astro.props as { currentPage?: number };
const pageSize = 16;
const totalPages = Math.max(1, Math.ceil(sortedPosts.length / pageSize));
const paginatedPosts = sortedPosts.slice((currentPage - 1) * pageSize, currentPage * pageSize);

const categoryBadgeStyles: Record<string, string> = {
  regionales: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
  nacionales: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  sucesos: 'bg-rose-500/20 text-rose-400 border-rose-500/30',
  deportes: 'bg-amber-500/20 text-amber-400 border-amber-500/30',
  internacionales: 'bg-purple-500/20 text-purple-400 border-purple-500/30',
  espectaculos: 'bg-pink-500/20 text-pink-400 border-pink-500/30',
  opinion: 'bg-cyan-500/20 text-cyan-400 border-cyan-500/30',
};
---

<Layout
  title={`Todas las Noticias | Archivo Informativo (${currentPage}/${totalPages}) - Entre Tormentas`}
  description="Archivo completo de noticias de Entre Tormentas: actualidad regional del Zulia, sucesos, política nacional, deportes y opinión."
  type="website"
>
  <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <!-- Header de la Sección -->
    <header class="mb-8 border-b border-storm-800 pb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wider bg-electric-600/20 text-ion-300 border border-electric-500/30">
          Archivo Editorial
        </span>
        <span class="text-xs text-slate-400 font-mono">
          {sortedPosts.length.toLocaleString('es-VE')} artículos publicados
        </span>
      </div>
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Todas las Noticias
      </h1>
      <p class="mt-2 text-sm text-slate-400 max-w-2xl">
        Cobertura minuto a minuto del estado Zulia, Venezuela y el mundo. Navega por nuestro archivo histórico completo.
      </p>

      <!-- Selector Rápido de Categorías -->
      <nav class="mt-6 flex flex-wrap gap-2 pt-4 border-t border-storm-800/60" aria-label="Filtro rápido por categoría">
        <a href="/noticias" class="rounded-full bg-electric-600 px-3.5 py-1 text-xs font-bold text-white shadow-md shadow-electric-600/30">
          Todas
        </a>
        <a href="/categoria/regionales" class="rounded-full bg-storm-900 border border-storm-700 px-3.5 py-1 text-xs font-medium text-slate-300 hover:border-emerald-500 hover:text-white transition">
          Regionales
        </a>
        <a href="/categoria/nacionales" class="rounded-full bg-storm-900 border border-storm-700 px-3.5 py-1 text-xs font-medium text-slate-300 hover:border-blue-500 hover:text-white transition">
          Nacionales
        </a>
        <a href="/categoria/deportes" class="rounded-full bg-storm-900 border border-storm-700 px-3.5 py-1 text-xs font-medium text-slate-300 hover:border-amber-500 hover:text-white transition">
          Deportes
        </a>
        <a href="/categoria/sucesos" class="rounded-full bg-storm-900 border border-storm-700 px-3.5 py-1 text-xs font-medium text-slate-300 hover:border-rose-500 hover:text-white transition">
          Sucesos
        </a>
        <a href="/categoria/internacionales" class="rounded-full bg-storm-900 border border-storm-700 px-3.5 py-1 text-xs font-medium text-slate-300 hover:border-purple-500 hover:text-white transition">
          Internacionales
        </a>
        <a href="/categoria/opinion" class="rounded-full bg-storm-900 border border-storm-700 px-3.5 py-1 text-xs font-medium text-slate-300 hover:border-cyan-500 hover:text-white transition">
          Opinión
        </a>
      </nav>
    </header>

    <!-- Grid de Noticias Paginadas -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {paginatedPosts.map((post) => {
        const catKey = (post.data.category || 'regionales').toLowerCase();
        const badgeClass = categoryBadgeStyles[catKey] || 'bg-storm-700/50 text-slate-300 border-storm-600';
        return (
          <a href={`/noticias/${post.id}`} class="block h-full">
            <article class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl h-full transition hover:border-electric-500">
              <div>
                <div class="relative h-44 w-full overflow-hidden bg-storm-800">
                  <img
                    src={post.data.coverImage || '/images/posts/default-post.jpg'}
                    alt={post.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.src='/images/posts/default-post.jpg'"
                  />
                  <span class={`absolute top-3 left-3 rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase backdrop-blur-md border ${badgeClass}`}>
                    {post.data.category || 'REGIONALES'}
                  </span>
                </div>
                <div class="p-4 space-y-2">
                  <h3 class="text-sm font-bold leading-snug text-white line-clamp-3 group-hover:text-ion-300 transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                    {resolveExcerpt(post.data.excerpt, post.body)}
                  </p>
                </div>
              </div>
              <div class="flex items-center justify-between border-t border-storm-800/80 px-4 py-3 text-[11px] text-slate-400 mt-auto">
                <span class="truncate max-w-[120px]">{post.data.author || 'Redacción'}</span>
                <span>{formatEditorialDate(post.data.publishedAt)}</span>
              </div>
            </article>
          </a>
        );
      })}
    </div>

    <!-- Paginador Numérico Limpio -->
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl="/noticias"
    />
  </div>

<script is:inline>
  // Enlaces viejos con ?page=N → ruta estática /pagina/N
  (function () {
    var p = new URLSearchParams(location.search).get('page') || new URLSearchParams(location.search).get('pagina');
    var n = parseInt(p || '', 10);
    if (n > 1 && !/\/pagina\//.test(location.pathname)) location.replace(location.pathname.replace(/\/$/, '') + '/pagina/' + n);
  })();
</script>
</Layout>
