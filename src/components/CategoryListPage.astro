---
import Layout from '../layouts/Layout.astro';
import Pagination from './Pagination.astro';
import { getActiveAd } from '../lib/site-settings';
import { getPostsByCategoryCached } from '../lib/posts-cache';
import AdBanner from './AdBanner.astro';

const { categoria = 'regionales', currentPage = 1 } = Astro.props as { categoria?: string; currentPage?: number };

function formatEditorialDate(value?: string | Date): string {
  if (!value) return 'Reciente';
  const parsed = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(parsed.getTime())) return String(value);
  return new Intl.DateTimeFormat('es-VE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(parsed);
}

const categoryLabels: Record<string, { title: string; desc: string; badge: string }> = {
  regionales: {
    title: 'Noticias Regionales · Zulia',
    desc: 'El pulso diario de Maracaibo, San Francisco, la Costa Oriental del Lago, Sur del Lago y todo el estado Zulia.',
    badge: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30'
  },
  nacionales: {
    title: 'Actualidad Nacional',
    desc: 'Los acontecimientos políticos, económicos y sociales más importantes de Venezuela.',
    badge: 'bg-blue-500/20 text-blue-400 border-blue-500/30'
  },
  sucesos: {
    title: 'Sucesos & Seguridad',
    desc: 'Reportes policiales, rescates, seguridad ciudadana y justicia en el occidente del país.',
    badge: 'bg-rose-500/20 text-rose-400 border-rose-500/30'
  },
  deportes: {
    title: 'Deportes',
    desc: 'La pasión de las Águilas del Zulia, Gaiteros, fútbol nacional, Grandes Ligas y deporte zuliano.',
    badge: 'bg-amber-500/20 text-amber-400 border-amber-500/30'
  },
  internacionales: {
    title: 'Mundo & Internacionales',
    desc: 'Geopolítica, noticias globales y eventos trascendentales en América Latina y el mundo.',
    badge: 'bg-purple-500/20 text-purple-400 border-purple-500/30'
  },
  espectaculos: {
    title: 'Arte & Espectáculos',
    desc: 'Cultura, música, farándula, tradiciones zulianas y entretenimiento.',
    badge: 'bg-pink-500/20 text-pink-400 border-pink-500/30'
  },
  opinion: {
    title: 'Opinión & Columnistas',
    desc: 'Análisis, tribunas, firmas invitadas y pensamiento crítico desde la región zuliana.',
    badge: 'bg-cyan-500/20 text-cyan-400 border-cyan-500/30'
  }
};

const currentMeta = categoryLabels[categoria.toLowerCase()] || {
  title: `Categoría: ${categoria.toUpperCase()}`,
  desc: `Archivo de noticias de ${categoria} en Entre Tormentas.`,
  badge: 'bg-storm-700/50 text-slate-300 border-storm-600'
};

// Obtener publicaciones filtradas directamente por categoría desde caché en memoria
const categoryPosts = await getPostsByCategoryCached(categoria.toLowerCase());

// Paginación
const pageSize = 12;
const totalPages = Math.max(1, Math.ceil(categoryPosts.length / pageSize));
const paginatedPosts = categoryPosts.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const categoryAd = await getActiveAd('category');
---

<Layout
  title={currentPage > 1 ? `${currentMeta.title} · Página ${currentPage} | Entre Tormentas` : `${currentMeta.title} | Entre Tormentas`}
  description={currentPage > 1 ? `${currentMeta.desc} Página ${currentPage} de ${totalPages}.` : currentMeta.desc}
  type="website"
  category={categoria}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: currentMeta.title, url: `/categoria/${categoria}` },
    ...(currentPage > 1 ? [{ name: `Página ${currentPage}`, url: `/categoria/${categoria}/pagina/${currentPage}` }] : []),
  ]}
>
  <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <!-- Category Hero Header -->
    <header class="mb-10 border-b border-storm-800 pb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class={`rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wider border ${currentMeta.badge}`}>
          Categoría
        </span>
        <span class="text-xs text-slate-400 font-mono">
          {categoryPosts.length} artículos archivados
        </span>
      </div>
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {currentMeta.title}
      </h1>
      <p class="mt-2 text-sm text-slate-300 max-w-2xl leading-relaxed">
        {currentMeta.desc}
      </p>
    </header>

    <!-- Leaderboard Ad -->
    <div class="mb-10">
      <AdBanner
        image={categoryAd?.image ?? "/images/ads/banner-header.png"}
        href={categoryAd?.href ?? "https://sedemat.gob.ve"}
        alt={categoryAd?.alt ?? "Publicidad"}
      />
    </div>

    <!-- Posts Grid -->
    {paginatedPosts.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {paginatedPosts.map((post) => (
          <article class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl">
            <a href={`/noticias/${post.id}`} class="block">
              <div class="relative h-48 w-full overflow-hidden bg-storm-800">
                <img
                  src={post.data.coverImage || '/images/posts/default-post.jpg'}
                  alt={post.data.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  onerror="this.src='/images/posts/default-post.jpg'"
                />
                <span class="absolute top-3 left-3 rounded-full bg-storm-950/85 px-2.5 py-0.5 text-[10px] font-bold text-ion-300 uppercase backdrop-blur-md border border-storm-700">
                  {post.data.category}
                </span>
              </div>
              <div class="p-4 space-y-2">
                <h2 class="text-base font-bold leading-snug text-white line-clamp-2 group-hover:text-ion-300 transition-colors">
                  {post.data.title}
                </h2>
                {post.data.excerpt && (
                  <p class="text-xs text-slate-300 line-clamp-3 leading-relaxed">
                    {post.data.excerpt}
                  </p>
                )}
              </div>
            </a>
            <div class="flex items-center justify-between border-t border-storm-800/80 px-4 py-3 text-[11px] text-slate-400">
              <span>{post.data.author || 'Redacción'}</span>
              <span>{formatEditorialDate(post.data.publishedAt)}</span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-storm-800 bg-storm-900/40 p-12 text-center">
        <p class="text-slate-400 text-sm">No se encontraron artículos en esta categoría.</p>
        <a href="/" class="mt-4 inline-block text-xs font-bold text-electric-brand hover:underline">
          Volver a la portada principal →
        </a>
      </div>
    )}

    <!-- Paginación -->
    {totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={`/categoria/${categoria}`}
      />
    )}
  </div>

<script is:inline>
  // Enlaces viejos con ?page=N → ruta estática /pagina/N
  (function () {
    var p = new URLSearchParams(location.search).get('page') || new URLSearchParams(location.search).get('pagina');
    var n = parseInt(p || '', 10);
    if (n > 1 && !/\/pagina\//.test(location.pathname)) location.replace(location.pathname.replace(/\/$/, '') + '/pagina/' + n);
  })();
</script>
</Layout>
