---
interface Props {
  slotType?: 'leaderboard' | 'in-article' | 'sidebar' | 'billboard';
  adClient?: string;
  adSlot?: string;
  image?: string;
  href?: string;
  alt?: string;
  className?: string;
}

const {
  slotType = 'leaderboard',
  adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '',
  adSlot = '',
  image = '/images/ads/banner-header.png',
  href = '#',
  alt = 'Espacio Publicitario - Entre Tormentas',
  className = ''
} = Astro.props;

// Dimensiones fijas mínimas para CLS = 0 (Cumulative Layout Shift prevention)
const minHeightClasses = {
  leaderboard: 'min-h-[50px] sm:min-h-[90px]',
  'in-article': 'min-h-[250px] sm:min-h-[280px]',
  sidebar: 'min-h-[250px] sm:min-h-[600px]',
  billboard: 'min-h-[100px] sm:min-h-[250px]',
}[slotType] || 'min-h-[90px]';

const isGoogleAdSenseConfigured = Boolean(adClient && adSlot);
---

<div
  class={`relative overflow-hidden rounded-xl border border-storm-800/80 bg-storm-950/60 p-2 backdrop-blur-sm transition-all hover:border-electric-500/40 ${minHeightClasses} flex flex-col justify-center items-center ${className}`}
  data-slot-type={slotType}
>
  <!-- Etiqueta de transparencia editorial requerida por Google AdSense y leyes de prensa -->
  <span class="absolute top-1.5 right-2 text-[9px] font-mono tracking-widest text-slate-500 uppercase z-10 pointer-events-none">
    Publicidad
  </span>

  {isGoogleAdSenseConfigured ? (
    <!-- Bloque Google AdSense con carga asíncrona -->
    <ins
      class="adsbygoogle block w-full text-center"
      style="display:block"
      data-ad-client={adClient}
      data-ad-slot={adSlot}
      data-ad-format={slotType === 'in-article' ? 'fluid' : 'auto'}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  ) : (
    <!-- Banner de Patrocinio Directo Institucional / Fallback sin CLS -->
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-full h-full items-center justify-center group"
    >
      <img
        src={image}
        alt={alt}
        class="h-auto max-h-[90px] w-full max-w-full rounded-lg object-contain transition-transform duration-300 group-hover:opacity-95"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'"
      />
    </a>
  )}
</div>
