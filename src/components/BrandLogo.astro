---
interface Props {
  class?: string;
  size?: number | string;
  variant?: 'white' | 'vivid';
}

const { class: className = 'h-10 w-10', size, variant = 'white' } = Astro.props;
const isWhite = variant === 'white';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  fill="none"
  class={className}
  {...(size ? { width: size, height: size } : {})}
  aria-label="Entre Tormentas Logo"
>
  <defs>
    <linearGradient id="et-bolt-vivid" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8" />
      <stop offset="100%" stop-color="#0066FF" />
    </linearGradient>
    <linearGradient id="et-cloud-light" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#F0F9FF" />
    </linearGradient>
    <filter id="et-glow-filter" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#38BDF8" flood-opacity="0.55" />
    </filter>
  </defs>

  <!-- Nube (Blanco puro nítido) -->
  <path
    d="M 36 60 L 24 60 C 14 60 14 43 23 40 C 21 27 36 21 44 26 C 50 12 70 12 74 26 C 85 26 89 38 85 47 C 91 58 83 60 76 60 L 64 60"
    stroke={isWhite ? '#FFFFFF' : 'url(#et-cloud-light)'}
    stroke-width="6.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Rayo / Trueno (Blanco puro o Azul Eléctrico según variante) -->
  <polygon
    points="53,53 63,53 52,67 59,67 40,88 47,71 39,71"
    fill={isWhite ? '#FFFFFF' : 'url(#et-bolt-vivid)'}
    stroke={isWhite ? '#FFFFFF' : 'url(#et-bolt-vivid)'}
    stroke-width="1.5"
    stroke-linejoin="round"
    filter={isWhite ? undefined : 'url(#et-glow-filter)'}
  />

  <!-- Trazos de lluvia (Blanco puro o Cian según variante) -->
  <line
    x1="29"
    y1="69"
    x2="20"
    y2="81"
    stroke={isWhite ? '#FFFFFF' : '#38BDF8'}
    stroke-width="6"
    stroke-linecap="round"
  />
  <line
    x1="74"
    y1="71"
    x2="65"
    y2="83"
    stroke={isWhite ? '#FFFFFF' : '#38BDF8'}
    stroke-width="6"
    stroke-linecap="round"
  />
</svg>
