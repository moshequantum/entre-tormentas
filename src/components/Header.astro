---
import AdBanner from './AdBanner.astro';
import BreakingTicker from './BreakingTicker.astro';

import { getCollection } from 'astro:content';

const categories = [
  { name: 'Regionales', href: '/categoria/regionales' },
  { name: 'Deportes', href: '/categoria/deportes' },
  { name: 'Nacionales', href: '/categoria/nacionales' },
  { name: 'Sucesos', href: '/categoria/sucesos' },
  { name: 'Internacionales', href: '/categoria/internacionales' },
  { name: 'Espectáculos', href: '/categoria/espectaculos' },
  { name: 'Opinión', href: '/categoria/opinion' },
];

const today = new Intl.DateTimeFormat('es-VE', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(new Date());

const allPosts = await getCollection('posts');
const recentTickerPosts = allPosts
  .sort((a, b) => new Date(b.data.publishedAt || 0).getTime() - new Date(a.data.publishedAt || 0).getTime())
  .slice(0, 5)
  .map((p) => ({
    title: p.data.title,
    href: `/noticias/${p.id}`,
    image: p.data.coverImage || '/images/posts/default-post.jpg',
    category: p.data.category.toUpperCase()
  }));
---

<header id="main-header" class="w-full sticky top-0 z-50 transition-all duration-300 bg-storm-950/95 backdrop-blur-md border-b border-storm-700/60 shadow-lg">
  
  <!-- Top Telemetry & Date Bar (Shrinks & hides on scroll) -->
  <div id="header-telemetry" class="border-b border-storm-800/80 bg-storm-900/90 px-4 py-1.5 text-xs text-slate-400 transition-all duration-300 overflow-hidden">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center gap-4 text-[11px] font-mono capitalize text-slate-300">
        <span>📍 Maracaibo, Zulia</span>
        <span class="text-storm-600">|</span>
        <span>{today}</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 rounded border border-storm-800 bg-storm-950/60 px-2 py-0.5 text-[11px] text-ion-300 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-ion-400 animate-pulse"></span>
          <span>Catatumbo: Actividad Alta</span>
        </div>
        <a href="/login" class="rounded border border-electric-500/40 bg-electric-600/20 px-2.5 py-0.5 text-[11px] font-bold text-electric-300 transition hover:bg-electric-600 hover:text-white">
          EntreTormentas CMS
        </a>
      </div>
    </div>
  </div>

  <!-- Main Masthead: Brand Logo + Sponsor (Compresses on scroll) -->
  <div id="header-masthead" class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 transition-all duration-300">
    <!-- Logotype Brand -->
    <a href="/" class="group flex items-center gap-3 transition flex-shrink-0">
      <!-- Boutique Isologo Vector Badge -->
      <div id="header-isologo" class="relative flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-electric-brand to-electric-600 p-2.5 shadow-lg shadow-electric-brand/25 border border-white/10 transition-all duration-300 group-hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-full w-full" fill="none">
          <path
            d="M18 3L6 17H15L13 29L26 14H17L18 3Z"
            fill="url(#lightning-header-grad)"
            stroke="#ffffff"
            stroke-width="0.75"
            stroke-linejoin="round"
          />
          <defs>
            <linearGradient id="lightning-header-grad" x1="6" y1="3" x2="26" y2="29" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FFFFFF" />
              <stop offset="0.65" stop-color="#E0F2FE" />
              <stop offset="1" stop-color="#38BDF8" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <div class="flex flex-col">
        <div class="flex items-baseline gap-1.5">
          <span id="brand-word-entre" class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-white transition-all duration-300 group-hover:text-slate-200">
            Entre
          </span>
          <span id="brand-word-tormentas" class="font-serif italic text-2xl sm:text-3xl font-bold tracking-tight text-white transition-all duration-300 group-hover:text-ion-300">
            Tormentas
          </span>
        </div>
        <div id="header-tagline" class="flex items-center gap-2 mt-0.5 transition-all duration-300">
          <span class="h-1.5 w-1.5 rounded-full bg-ion-400 animate-pulse"></span>
          <span class="text-[10px] font-mono font-medium tracking-[0.2em] text-slate-400 uppercase">
            Diario Digital · Zulia
          </span>
        </div>
      </div>
    </a>

    <!-- Header Ad Banner (Hidden on shrink scroll) -->
    <div id="header-ad-banner" class="hidden md:block flex-1 max-w-[540px] transition-all duration-300">
      <AdBanner
        image="/images/ads/banner-header.png"
        href="https://sedemat.gob.ve"
        alt="Alcaldía de Maracaibo - SEDEMAT"
      />
    </div>

    <!-- Quick CMS Pill (Visible on shrink scroll) -->
    <a href="/login" id="header-shrink-cms" class="hidden rounded-lg bg-electric-600 px-3 py-1.5 text-xs font-bold text-white shadow-md transition hover:bg-electric-500">
      CMS
    </a>
  </div>

  <!-- Primary Categories Navigation (Solid Brand Blue Bar) -->
  <nav id="header-categories" class="bg-electric-brand text-white shadow-md transition-all duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
      <ul class="flex items-center gap-1 sm:gap-2 overflow-x-auto py-1 text-xs sm:text-sm font-bold tracking-wider uppercase no-scrollbar">
        {categories.map((cat) => (
          <li>
            <a
              href={cat.href}
              class="px-2.5 py-1.5 rounded transition-colors hover:bg-white/15 focus:outline-none inline-block whitespace-nowrap"
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
      <a href="/login" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-white/90 hover:text-white px-2 py-1 rounded hover:bg-white/10 transition">
        EntreTormentas CMS
      </a>
    </div>
  </nav>

  <!-- Breaking News Ticker (Stuck in natural flow, hidden on shrink) -->
  <div id="header-ticker" class="transition-all duration-300">
    <BreakingTicker items={recentTickerPosts} />
  </div>
</header>

<script>
  // Shrink Header on Scroll (Minimal Mode)
  const telemetry = document.getElementById('header-telemetry');
  const masthead = document.getElementById('header-masthead');
  const adBanner = document.getElementById('header-ad-banner');
  const ticker = document.getElementById('header-ticker');
  const isologo = document.getElementById('header-isologo');
  const brandEntre = document.getElementById('brand-word-entre');
  const brandTormentas = document.getElementById('brand-word-tormentas');
  const tagline = document.getElementById('header-tagline');
  const shrinkCms = document.getElementById('header-shrink-cms');

  let isShrunk = false;

  window.addEventListener('scroll', () => {
    const shouldShrink = window.scrollY > 60;

    if (shouldShrink && !isShrunk) {
      isShrunk = true;
      // Shrink components
      if (telemetry) telemetry.style.display = 'none';
      if (adBanner) adBanner.style.display = 'none';
      if (ticker) ticker.style.display = 'none';
      if (tagline) tagline.style.display = 'none';
      if (shrinkCms) shrinkCms.classList.remove('hidden');

      if (masthead) {
        masthead.classList.remove('py-3');
        masthead.classList.add('py-1.5');
      }

      if (isologo) {
        isologo.classList.remove('h-11', 'w-11', 'sm:h-12', 'sm:w-12', 'p-2.5');
        isologo.classList.add('h-8', 'w-8', 'p-1.5');
      }

      if (brandEntre) {
        brandEntre.classList.remove('text-2xl', 'sm:text-3xl');
        brandEntre.classList.add('text-lg', 'sm:text-xl');
      }

      if (brandTormentas) {
        brandTormentas.classList.remove('text-2xl', 'sm:text-3xl');
        brandTormentas.classList.add('text-lg', 'sm:text-xl');
      }
    } else if (!shouldShrink && isShrunk) {
      isShrunk = false;
      // Expand back to full masthead
      if (telemetry) telemetry.style.display = '';
      if (adBanner) adBanner.style.display = '';
      if (ticker) ticker.style.display = '';
      if (tagline) tagline.style.display = '';
      if (shrinkCms) shrinkCms.classList.add('hidden');

      if (masthead) {
        masthead.classList.remove('py-1.5');
        masthead.classList.add('py-3');
      }

      if (isologo) {
        isologo.classList.remove('h-8', 'w-8', 'p-1.5');
        isologo.classList.add('h-11', 'w-11', 'sm:h-12', 'sm:w-12', 'p-2.5');
      }

      if (brandEntre) {
        brandEntre.classList.remove('text-lg', 'sm:text-xl');
        brandEntre.classList.add('text-2xl', 'sm:text-3xl');
      }

      if (brandTormentas) {
        brandTormentas.classList.remove('text-lg', 'sm:text-xl');
        brandTormentas.classList.add('text-2xl', 'sm:text-3xl');
      }
    }
  }, { passive: true });
</script>
