---
import AdBanner from './AdBanner.astro';
import BreakingTicker from './BreakingTicker.astro';
import BrandLogo from './BrandLogo.astro';

import { getCollection } from 'astro:content';
import { getSiteSettings, getActiveAd } from '../lib/site-settings';

const categories = [
  { name: 'Regionales', href: '/categoria/regionales' },
  { name: 'Deportes', href: '/categoria/deportes' },
  { name: 'Nacionales', href: '/categoria/nacionales' },
  { name: 'Sucesos', href: '/categoria/sucesos' },
  { name: 'Internacionales', href: '/categoria/internacionales' },
  { name: 'Espectáculos', href: '/categoria/espectaculos' },
  { name: 'Opinión', href: '/categoria/opinion' },
];

const today = new Intl.DateTimeFormat('es-VE', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(new Date());

const siteSettings = await getSiteSettings();
const headerAd = await getActiveAd('header');

const allPosts = await getCollection('posts');
const recentTickerPosts = allPosts
  .sort((a, b) => new Date(b.data.publishedAt || 0).getTime() - new Date(a.data.publishedAt || 0).getTime())
  .slice(0, 5)
  .map((p) => ({
    title: p.data.title,
    href: `/noticias/${p.id}`,
    image: p.data.coverImage || '/images/posts/default-post.jpg',
    category: p.data.category.toUpperCase()
  }));
---

<header id="main-header" class="w-full sticky top-0 z-50 bg-storm-950/95 backdrop-blur-md border-b border-storm-800/80 shadow-editorial-card overflow-hidden">
  {siteSettings.headerBackground && (
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <img
        src={siteSettings.headerBackground}
        alt=""
        aria-hidden="true"
        class="h-full w-full object-cover object-center scale-105"
        style={`opacity: ${siteSettings.headerBackgroundOpacity / 100};`}
      />
      <!-- Smooth dark vignette & gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-storm-950/75 via-storm-950/85 to-storm-950/95"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-storm-950/30 to-storm-950/85"></div>
    </div>
  )}

  <!-- Top Telemetry & Date Bar (Smoothly collapses on scroll) -->
  <div id="header-telemetry" class="relative z-10 border-b border-storm-800/60 bg-storm-950/80 px-4 py-1.5 text-xs text-slate-400 overflow-hidden">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center gap-4 text-[11px] font-mono capitalize text-slate-400">
        <span>📍 Maracaibo, Zulia</span>
        <span class="text-storm-700">|</span>
        <span>{today}</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Amber Catatumbo Atmospheric Indicator -->
        <div class="flex items-center gap-2 rounded-md border border-amber-500/20 bg-amber-500/10 px-2.5 py-0.5 text-[11px] text-amber-300/90 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="font-medium">Catatumbo: Actividad Alta</span>
        </div>
        <a
          href="/login"
          class="rounded-md border border-white/10 bg-white/[0.04] px-2.5 py-0.5 text-[11px] font-medium text-slate-300 transition-all hover:border-electric-400/40 hover:bg-electric-500/10 hover:text-white"
        >
          EntreTormentas CMS
        </a>
      </div>
    </div>
  </div>

  <!-- Main Masthead: Brand Logo + Sponsor (Compresses to ultra-minimal on scroll) -->
  <div id="header-masthead" class="relative z-10 mx-auto flex max-w-7xl items-center justify-between gap-8 px-4 py-4 sm:px-6 transition-all duration-300">
    <!-- Logotype Brand -->
    <a href="/" class="group flex items-center gap-3.5 transition flex-shrink-0">
      <!-- Boutique Isologo Vector Badge with Midnight-Electric Lighting -->
      {siteSettings.logo ? (
        <img
          id="header-isologo"
          src={siteSettings.logo}
          alt="Entre Tormentas"
          class="relative h-11 w-11 sm:h-12 sm:w-12 rounded-xl object-contain transition-all duration-300 group-hover:scale-105"
        />
      ) : (
        <div id="header-isologo" class="relative flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-storm-900 via-storm-950 to-storm-900 p-1.5 shadow-editorial-glow border border-electric-500/30 transition-all duration-300 group-hover:scale-105 group-hover:border-electric-400">
          <BrandLogo class="h-full w-full" />
        </div>
      )}

      <div class="flex flex-col">
        <div class="flex items-baseline gap-1.5">
          <span id="brand-word-entre" class="font-serif text-2xl sm:text-3xl font-normal tracking-tight text-editorial-parchment transition-all duration-300 group-hover:text-white">
            Entre
          </span>
          <span id="brand-word-tormentas" class="font-serif italic text-2xl sm:text-3xl font-medium tracking-tight text-white transition-all duration-300 group-hover:text-electric-300">
            Tormentas
          </span>
        </div>
        <div id="header-tagline" class="flex items-center gap-2 mt-0.5">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="text-[10px] font-mono font-medium tracking-[0.22em] text-slate-400 uppercase">
            Diario Digital · Zulia
          </span>
        </div>
      </div>
    </a>

    <!-- Header Ad Banner (Hidden on shrink scroll) -->
    <div id="header-ad-banner" class="hidden md:block flex-1 max-w-[540px]">
      <AdBanner
        image={headerAd?.image ?? '/images/ads/banner-header.png'}
        href={headerAd?.href ?? 'https://sedemat.gob.ve'}
        alt={headerAd?.alt ?? 'SEDEMAT - Alcaldía de Maracaibo'}
      />
    </div>

    <!-- Quick CMS Pill (Visible on shrink scroll) -->
    <a href="/login" id="header-shrink-cms" class="hidden items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.06] px-3 py-1.5 text-xs font-medium text-slate-200 shadow-sm transition-all hover:bg-white/[0.12] hover:text-white">
      <span>CMS</span>
    </a>
  </div>

  <!-- Primary Categories Navigation (Humanized Slate Editorial Bar with Tints & Shadows) -->
  <nav id="header-categories" class="relative z-10 bg-editorial-surface/95 text-slate-300 border-y border-white/[0.08] shadow-editorial-nav transition-all duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
      <ul class="flex items-center gap-1 sm:gap-2 overflow-x-auto py-1.5 text-xs sm:text-[13px] font-medium tracking-wider uppercase no-scrollbar">
        {categories.map((cat) => (
          <li>
            <a
              href={cat.href}
              class="px-3 py-1.5 rounded-md text-slate-300 transition-colors hover:bg-white/[0.07] hover:text-white focus:outline-none inline-block whitespace-nowrap"
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/login"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-electric-300 bg-electric-500/10 border border-electric-400/25 px-3 py-1 rounded-md hover:bg-electric-500/20 hover:border-electric-400/40 hover:text-white transition-all shadow-sm"
      >
        EntreTormentas CMS
      </a>
    </div>
  </nav>

  <!-- Breaking News Ticker (Stuck in natural flow, hidden on shrink) -->
  <div id="header-ticker" class="relative z-10">
    <BreakingTicker items={recentTickerPosts} />
  </div>
</header>

<style>
  /* Seamless GPU-accelerated Header Shrink Transitions */
  #main-header {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  #header-telemetry {
    max-height: 48px;
    opacity: 1;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, padding 0.3s ease;
  }

  #header-ticker {
    max-height: 48px;
    opacity: 1;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  #header-masthead {
    transition: padding 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #header-isologo {
    transition: width 0.25s ease, height 0.25s ease, padding 0.25s ease;
  }

  /* Minimal Shrink Active State */
  #main-header.header-shrunk #header-telemetry {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-bottom: none;
    pointer-events: none;
  }

  #main-header.header-shrunk #header-ticker {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  #main-header.header-shrunk #header-ad-banner {
    display: none;
  }

  #main-header.header-shrunk #header-tagline {
    display: none;
  }

  #main-header.header-shrunk #header-masthead {
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }

  #main-header.header-shrunk #header-isologo {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.35rem;
  }

  #main-header.header-shrunk #brand-word-entre,
  #main-header.header-shrunk #brand-word-tormentas {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  #main-header.header-shrunk #header-shrink-cms {
    display: inline-flex;
  }

  #main-header.header-shrunk #header-categories ul {
    padding-top: 0.125rem;
    padding-bottom: 0.125rem;
  }
</style>

<script>
  // Shrink Header on Scroll (Minimal Mode)
  const header = document.getElementById('main-header');
  if (header) {
    const updateHeader = () => {
      const isShrunk = window.scrollY > 50;
      header.classList.toggle('header-shrunk', isShrunk);
    };

    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }
</script>
