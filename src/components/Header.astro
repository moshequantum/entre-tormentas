---
import AdBanner from './AdBanner.astro';
import BreakingTicker from './BreakingTicker.astro';

import { getCollection } from 'astro:content';

const categories = [
  { name: 'Internacionales', href: '/categoria/internacionales' },
  { name: 'Nacionales', href: '/categoria/nacionales' },
  { name: 'Regionales', href: '/categoria/regionales' },
  { name: 'Sucesos', href: '/categoria/sucesos' },
  { name: 'Deportes', href: '/categoria/deportes' },
  { name: 'Espectáculos', href: '/categoria/espectaculos' },
  { name: 'Opinión', href: '/categoria/opinion' },
];

const today = new Intl.DateTimeFormat('es-VE', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(new Date());

const allPosts = await getCollection('posts');
const recentTickerPosts = allPosts
  .sort((a, b) => new Date(b.data.publishedAt || 0).getTime() - new Date(a.data.publishedAt || 0).getTime())
  .slice(0, 5)
  .map((p) => ({
    title: p.data.title,
    href: `/noticias/${p.id}`,
    image: p.data.coverImage || '/images/posts/default-post.jpg',
    category: p.data.category.toUpperCase()
  }));
---

<header class="w-full border-b border-storm-700/60 bg-storm-950/98 sticky top-0 z-50 backdrop-blur-md">
  <!-- Top Telemetry & Date Bar -->
  <div class="border-b border-storm-800/80 bg-storm-900/80 px-4 py-1.5 text-xs text-slate-400">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center gap-4 text-[11px] font-mono capitalize text-slate-300">
        <span>📍 Maracaibo, Zulia</span>
        <span class="text-storm-600">|</span>
        <span>{today}</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 rounded border border-storm-800 bg-storm-950/60 px-2 py-0.5 text-[11px] text-ion-300 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-ion-400 animate-pulse"></span>
          <span>Catatumbo: Actividad Alta</span>
        </div>
        <a href="/keystatic" class="rounded border border-storm-700 bg-storm-800/80 px-2.5 py-0.5 text-[11px] font-semibold text-slate-200 transition hover:border-electric-brand hover:text-white">
          Redacción CMS
        </a>
      </div>
    </div>
  </div>

  <!-- Main Masthead: Brand Logo + Sponsor / Publicidad Leaderboard -->
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
    <!-- Logotype Brand -->
    <a href="/" class="group flex items-center gap-3.5 transition flex-shrink-0">
      <!-- Boutique Isologo Vector Badge -->
      <div class="relative flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-electric-brand to-electric-600 p-2.5 shadow-lg shadow-electric-brand/25 border border-white/10 transition-all duration-300 group-hover:scale-105 group-hover:shadow-electric-brand/40">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-full w-full" fill="none">
          <path
            d="M18 3L6 17H15L13 29L26 14H17L18 3Z"
            fill="url(#lightning-header-grad)"
            stroke="#ffffff"
            stroke-width="0.75"
            stroke-linejoin="round"
          />
          <defs>
            <linearGradient id="lightning-header-grad" x1="6" y1="3" x2="26" y2="29" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FFFFFF" />
              <stop offset="0.65" stop-color="#E0F2FE" />
              <stop offset="1" stop-color="#38BDF8" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="flex flex-col">
        <div class="flex items-baseline gap-2">
          <!-- All Editorial Serif: 'Entre' in Roman + 'Tormentas' in Italic -->
          <span class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-white transition-colors group-hover:text-slate-200">
            Entre
          </span>
          <span class="font-serif italic text-2xl sm:text-3xl font-bold tracking-tight text-white transition-colors group-hover:text-ion-300">
            Tormentas
          </span>
        </div>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="h-1.5 w-1.5 rounded-full bg-ion-400 animate-pulse"></span>
          <span class="text-[10px] font-mono font-medium tracking-[0.2em] text-slate-400 uppercase">
            Diario Digital · Zulia
          </span>
        </div>
      </div>
    </a>

    <!-- Header Ad Banner Slot (Leaderboard Rescatado de entretormentas.com) -->
    <div class="hidden md:block flex-1 max-w-[560px]">
      <AdBanner
        image="/images/ads/banner-header.png"
        href="https://sedemat.gob.ve"
        alt="Alcaldía de Maracaibo - SEDEMAT"
      />
    </div>
  </div>

  <!-- Primary Categories Navigation (Solid Brand Blue Bar) -->
  <nav class="bg-electric-brand text-white shadow-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
      <ul class="flex items-center gap-1 sm:gap-2 overflow-x-auto py-1 text-xs sm:text-sm font-bold tracking-wider uppercase no-scrollbar">
        {categories.map((cat) => (
          <li>
            <a
              href={cat.href}
              class="px-2.5 py-2 rounded transition-colors hover:bg-white/15 focus:outline-none inline-block whitespace-nowrap"
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
      <!-- Search button -->
      <button
        type="button"
        aria-label="Buscar noticias"
        class="ml-2 flex h-8 w-8 items-center justify-center rounded-full hover:bg-white/20 transition-colors text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Breaking News Ticker -->
  <BreakingTicker items={recentTickerPosts} />
</header>
