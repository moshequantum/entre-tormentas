---
import { img, IMG_FALLBACK } from '../lib/img';
interface TickerItem {
  title: string;
  href: string;
  image?: string;
  category?: string;
}

interface Props {
  items?: TickerItem[];
}

const defaultItems: TickerItem[] = [
  {
    title: '¡AFILANDO SUS GARRAS! Guillermo Quiroz dirigió su primera práctica en el nido aguilucho',
    href: '#',
    image: 'https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=120&auto=format&fit=crop',
    category: 'Deportes'
  },
  {
    title: '¡DESDE EL ZULIA! Inician operativo especial de mantenimiento nocturno en el Puente Sobre el Lago',
    href: '#',
    image: 'https://images.unsplash.com/photo-1506521781263-d8422e82f27a?q=80&w=120&auto=format&fit=crop',
    category: 'Regionales'
  },
  {
    title: 'Pronóstico del Relámpago del Catatumbo: Reportan alta actividad eléctrica en la cuenca sur',
    href: '#',
    image: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?q=80&w=120&auto=format&fit=crop',
    category: 'Clima'
  }
];

const { items = defaultItems } = Astro.props;
---

<div class="border-b border-storm-800/80 bg-storm-950/95 shadow-sm">
  <div class="mx-auto flex max-w-7xl items-stretch overflow-hidden">
    <!-- Editorial Ticker Badge (Vibrant High-Contrast Accent) -->
    <div class="flex items-center gap-2.5 border-r border-storm-800/80 bg-gradient-to-r from-storm-900 via-storm-950 to-storm-900 px-4 py-2 font-sans text-xs font-bold tracking-widest text-amber-300 uppercase whitespace-nowrap z-10 shadow-sm border-l-2 border-l-amber-400">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-80"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.9)]"></span>
      </span>
      <span class="text-xs font-bold tracking-widest text-amber-300">Últimas Noticias</span>
    </div>

    <!-- Ticker Stream -->
    <div class="relative flex-1 overflow-hidden py-2 px-4 flex items-center bg-storm-950/40">
      <div class="flex items-center gap-8 animate-marquee whitespace-nowrap">
        {items.map((item) => (
          <a href={item.href} class="group inline-flex items-center gap-3 transition-colors">
            {item.image && (
              <img
                {...img(item.image, 'thumb')}
                alt=""
                class="h-6 w-9 rounded-md object-cover border border-storm-800/80 group-hover:border-electric-400/50 shadow-sm transition-all"
                loading="lazy"
              />
            )}
            <span class="text-xs font-normal text-slate-300 group-hover:text-white transition-colors">
              {item.title}
            </span>
            <span class="text-storm-700 font-light">/</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: inline-flex;
    animation: marquee 25s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
