---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  category?: string;
  author?: string;
  canonical?: string;
}

const {
  title = 'Entre Tormentas | Diario Digital del Zulia',
  description = 'Noticias de actualidad, sucesos, deportes, regionales y política en el Zulia y Venezuela.',
  image = '/images/posts/default-post.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  category,
  author = 'Redacción Entre Tormentas',
  canonical
} = Astro.props;

const siteUrl = 'https://www.entretormentas.com';
const canonicalUrl = canonical || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `${siteUrl}${Astro.url.pathname}`);
const absoluteImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// ISO Dates for Article Schema & OG
let isoPublished = '';
if (publishedTime) {
  try {
    const d = new Date(publishedTime);
    if (!isNaN(d.getTime())) isoPublished = d.toISOString();
  } catch (e) {}
}

let isoModified = '';
if (modifiedTime) {
  try {
    const d = new Date(modifiedTime);
    if (!isNaN(d.getTime())) isoModified = d.toISOString();
  } catch (e) {}
}

// Schema.org JSON-LD structured data (SEO, GEO & AEO)
const schemaData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      'mainEntityOfPage': {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      'headline': title,
      'description': description,
      'image': [absoluteImageUrl],
      'datePublished': isoPublished || new Date().toISOString(),
      'dateModified': isoModified || isoPublished || new Date().toISOString(),
      'author': {
        '@type': 'Person',
        'name': author,
        'url': siteUrl
      },
      'publisher': {
        '@type': 'NewsMediaOrganization',
        'name': 'Entre Tormentas',
        'url': siteUrl,
        'logo': {
          '@type': 'ImageObject',
          'url': `${siteUrl}/favicon.svg`
        }
      },
      'articleSection': category || 'General',
      'inLanguage': 'es-VE',
      'contentLocation': {
        '@type': 'Place',
        'name': 'Maracaibo, Estado Zulia, Venezuela',
        'geo': {
          '@type': 'GeoCoordinates',
          'latitude': 10.6427,
          'longitude': -71.6125
        }
      },
      'speakable': {
        '@type': 'SpeakableSpecification',
        'cssSelector': ['h1', '.article-lead', '.article-excerpt']
      }
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'NewsMediaOrganization',
          '@id': `${siteUrl}/#organization`,
          'name': 'Entre Tormentas',
          'url': siteUrl,
          'logo': `${siteUrl}/favicon.svg`,
          'description': 'Diario digital de noticias, opinión y sucesos del Estado Zulia y Venezuela.',
          'address': {
            '@type': 'PostalAddress',
            'addressLocality': 'Maracaibo',
            'addressRegion': 'Zulia',
            'addressCountry': 'VE'
          },
          'sameAs': [
            'https://twitter.com/EntreTormentas',
            'https://www.instagram.com/entretormentas',
            'https://www.facebook.com/EntreTormentas'
          ]
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          'url': siteUrl,
          'name': 'Entre Tormentas',
          'publisher': {
            '@id': `${siteUrl}/#organization`
          },
          'inLanguage': 'es-VE'
        }
      ]
    };
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Search Engine Optimization (SEO) Crawlers -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Geotargeting (GEO) - Maracaibo / Zulia / Venezuela -->
    <meta name="geo.region" content="VE-V" />
    <meta name="geo.placename" content="Maracaibo, Estado Zulia, Venezuela" />
    <meta name="geo.position" content="10.6427;-71.6125" />
    <meta name="ICBM" content="10.6427, -71.6125" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:site_name" content="Entre Tormentas" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:alt" content={title} />
    {type === 'article' && isoPublished && <meta property="article:published_time" content={isoPublished} />}
    {type === 'article' && category && <meta property="article:section" content={category} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@EntreTormentas" />
    <meta name="twitter:creator" content="@EntreTormentas" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Syndication & Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Entre Tormentas RSS Feed" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Structured Data JSON-LD (SEO, GEO & AEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google AdSense Official Script (Asynchronous & Non-blocking) -->
    {import.meta.env.PUBLIC_ADSENSE_CLIENT_ID && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Typography: Lora (Editorial Serif), Geist (Interface Sans) & Geist Mono (Telemetry) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-storm-950 text-slate-100 flex flex-col antialiased">
    <!-- Accessibility Skip Link (WCAG 2.1 AA requirement) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:rounded-lg focus:bg-electric-brand focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:text-white focus:shadow-xl focus:outline-none"
    >
      Saltar al contenido principal
    </a>

    <!-- Top Scroll Progress Bar (Frontend-Craft standard) -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-electric-500 via-ion-400 to-electric-600 z-[100] w-0 transition-all duration-75"></div>

    <Header />

    <main id="main-content" class="flex-1 focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll Progress Tracker
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('scroll-progress');
        if (progressBar) {
          progressBar.style.width = scrolled + '%';
        }
      });
    </script>
  </body>
</html>
