---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/site-settings';
// Fuentes servidas desde el propio dominio (sin bloqueo de render por Google Fonts).
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  category?: string;
  author?: string;
  tags?: string[];
  canonical?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  /** Imagen LCP a precargar: el resultado de img(src, preset). */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
}

const {
  title = 'Entre Tormentas | Diario Digital del Zulia',
  description = 'Noticias de actualidad, sucesos, deportes, regionales y política en el Zulia y Venezuela.',
  image = '/images/posts/default-post.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  category,
  author = 'Redacción Entre Tormentas',
  tags = [],
  canonical,
  noindex = false,
  breadcrumbs = [],
  preloadImage,
} = Astro.props;

const siteUrl = 'https://www.entretormentas.com';
// Las URLs públicas no llevan barra final (el Worker sirve /x y redirige /x/ → /x).
const normalizedPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = canonical || `${siteUrl}${normalizedPath}`;
const logoUrl = `${siteUrl}/images/brand/isologo-e-concept.jpg`;
const absoluteImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// Favicon editable desde Keystatic (Ajustes del sitio); si no hay uno guardado se
// mantiene el /favicon.svg por defecto. La extensión define el MIME del <link>.
const siteSettings = await getSiteSettings();
const faviconHref = siteSettings.favicon || '/favicon.svg';
const faviconExt = faviconHref.split('.').pop()?.toLowerCase();
const faviconType =
  faviconExt === 'svg'
    ? 'image/svg+xml'
    : faviconExt === 'png'
      ? 'image/png'
      : faviconExt === 'ico'
        ? 'image/x-icon'
        : faviconExt === 'webp'
          ? 'image/webp'
          : faviconExt === 'gif'
            ? 'image/gif'
            : faviconExt === 'jpg' || faviconExt === 'jpeg'
              ? 'image/jpeg'
              : undefined;
const faviconUrl = faviconHref.startsWith('http')
  ? faviconHref
  : `${siteUrl}${faviconHref.startsWith('/') ? '' : '/'}${faviconHref}`;

// ISO Dates for Article Schema & OG
let isoPublished = '';
if (publishedTime) {
  try {
    const d = new Date(publishedTime);
    if (!isNaN(d.getTime())) isoPublished = d.toISOString();
  } catch (e) {}
}

let isoModified = '';
if (modifiedTime) {
  try {
    const d = new Date(modifiedTime);
    if (!isNaN(d.getTime())) isoModified = d.toISOString();
  } catch (e) {}
}

const cleanTags = tags.filter((t) => typeof t === 'string' && t.trim().length > 0).map((t) => t.trim());
const keywordsMeta = cleanTags.length > 0
  ? cleanTags.join(', ')
  : `${category || 'Noticias'}, Maracaibo, Zulia, Venezuela, Entre Tormentas`;

// Schema.org JSON-LD (SEO, GEO & AEO): un solo @graph con entidades enlazadas por @id.
const organization = {
  '@type': 'NewsMediaOrganization',
  '@id': `${siteUrl}/#organization`,
  name: 'Entre Tormentas',
  alternateName: 'Entre Tormentas Diario Digital',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: logoUrl },
  image: logoUrl,
  description: 'Diario digital de noticias, opinión y sucesos del estado Zulia y Venezuela.',
  foundingLocation: { '@type': 'Place', name: 'Maracaibo, Zulia, Venezuela' },
  areaServed: [
    { '@type': 'State', name: 'Zulia', containedInPlace: { '@type': 'Country', name: 'Venezuela' } },
    { '@type': 'Country', name: 'Venezuela' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Maracaibo',
    addressRegion: 'Zulia',
    addressCountry: 'VE',
  },
  sameAs: [
    'https://twitter.com/EntreTormentas',
    'https://www.instagram.com/entretormentas',
    'https://www.facebook.com/EntreTormentas',
  ],
  publishingPrinciples: `${siteUrl}/terminos`,
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Entre Tormentas',
  description: 'Noticias del Zulia y Venezuela: regionales, nacionales, sucesos, deportes y opinión.',
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'es-VE',
};

const isInstitutionalAuthor = !author || /redacci[oó]n|entre tormentas/i.test(author);

const graph: Record<string, unknown>[] = [organization, website];

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url}`,
    })),
  });
}

if (type === 'article') {
  graph.push({
    '@type': 'NewsArticle',
    '@id': `${canonicalUrl}#article`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    url: canonicalUrl,
    headline: title.replace(/\s*\|\s*Entre Tormentas$/, '').slice(0, 110),
    description,
    image: [absoluteImageUrl],
    thumbnailUrl: absoluteImageUrl,
    datePublished: isoPublished || undefined,
    dateModified: isoModified || isoPublished || undefined,
    author: isInstitutionalAuthor
      ? { '@id': `${siteUrl}/#organization` }
      : { '@type': 'Person', name: author },
    publisher: { '@id': `${siteUrl}/#organization` },
    isPartOf: { '@id': `${siteUrl}/#website` },
    articleSection: category || 'General',
    keywords: keywordsMeta,
    inLanguage: 'es-VE',
    isAccessibleForFree: true,
    breadcrumb: breadcrumbs.length > 0 ? { '@id': `${canonicalUrl}#breadcrumb` } : undefined,
    contentLocation: {
      '@type': 'Place',
      name: 'Maracaibo, Estado Zulia, Venezuela',
      geo: { '@type': 'GeoCoordinates', latitude: 10.6427, longitude: -71.6125 },
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.article-lead', '.article-excerpt'],
    },
  });
} else {
  graph.push({
    '@type': 'WebPage',
    '@id': canonicalUrl,
    url: canonicalUrl,
    name: title,
    description,
    isPartOf: { '@id': `${siteUrl}/#website` },
    about: { '@id': `${siteUrl}/#organization` },
    inLanguage: 'es-VE',
    breadcrumb: breadcrumbs.length > 0 ? { '@id': `${canonicalUrl}#breadcrumb` } : undefined,
  });
}

const schemaData = { '@context': 'https://schema.org', '@graph': graph };
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="es-VE" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={faviconType} href={faviconHref} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordsMeta} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Search Engine Optimization (SEO) Crawlers -->
    <meta name="robots" content={robotsContent} />
    <link rel="alternate" hreflang="es-VE" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Geotargeting (GEO) - Maracaibo / Zulia / Venezuela -->
    <meta name="geo.region" content="VE-V" />
    <meta name="geo.placename" content="Maracaibo, Estado Zulia, Venezuela" />
    <meta name="geo.position" content="10.6427;-71.6125" />
    <meta name="ICBM" content="10.6427, -71.6125" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:site_name" content="Entre Tormentas" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:alt" content={title} />
    {absoluteImageUrl.startsWith('https://') && <meta property="og:image:secure_url" content={absoluteImageUrl} />}
    {type === 'article' && isoPublished && <meta property="article:published_time" content={isoPublished} />}
    {type === 'article' && (isoModified || isoPublished) && <meta property="article:modified_time" content={isoModified || isoPublished} />}
    {type === 'article' && <meta property="article:publisher" content="https://www.facebook.com/EntreTormentas" />}
    {type === 'article' && category && <meta property="article:section" content={category} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {type === 'article' && cleanTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@EntreTormentas" />
    <meta name="twitter:creator" content="@EntreTormentas" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Syndication & Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Entre Tormentas RSS Feed" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="Resumen para asistentes de IA" href="/llms.txt" />

    <!-- Structured Data JSON-LD (SEO, GEO & AEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google AdSense Official Script (Asynchronous & Non-blocking) -->
    {import.meta.env.PUBLIC_ADSENSE_CLIENT_ID && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Typography: Geist (Interface & Editorial Sans) & Geist Mono (Telemetry) -->
    <link rel="preconnect" href="https://media.entretormentas.com" crossorigin />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.src}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}
  </head>
  <body class="min-h-screen bg-storm-950 text-slate-100 flex flex-col antialiased">
    <!-- Accessibility Skip Link (WCAG 2.1 AA requirement) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:rounded-lg focus:bg-electric-brand focus:px-4 focus:py-2 focus:text-xs focus:font-bold text-white focus:shadow-xl focus:outline-none"
    >
      Saltar al contenido principal
    </a>

    <!-- Top Scroll Progress Bar (Frontend-Craft standard) -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-electric-500 via-ion-400 to-electric-600 z-[100] w-0 transition-all duration-75"></div>

    <Header />

    <main id="main-content" class="flex-1 focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll Progress Tracker
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('scroll-progress');
        if (progressBar) {
          progressBar.style.width = scrolled + '%';
        }
      });
    </script>
  </body>
</html>
