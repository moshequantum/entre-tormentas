---
import '../styles/global.css';

interface Props {
  title?: string;
  activeTab?: 'entradas' | 'nueva';
}

const {
  title = 'EntreTormentas Backoffice',
  activeTab = 'entradas',
} = Astro.props;

// Read user session from cookie
const userCookie = Astro.cookies.get('entretormentas_user');
let activeUser = { email: 'Redactor Autorizado', name: 'Periodista' };
try {
  if (userCookie?.value) {
    activeUser = JSON.parse(userCookie.value);
  }
} catch (e) {}
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-[#070A12] text-slate-200">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-[#070A12] font-sans text-slate-200 antialiased selection:bg-electric-500/30 selection:text-white">
    
    <!-- Compact Backoffice Top Navigation Bar -->
    <header class="sticky top-0 z-50 border-b border-white/[0.08] bg-[#0A0E1A]/95 px-3 py-2 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        
        <!-- Left: Brand + Navigation Tabs -->
        <div class="flex items-center gap-4 sm:gap-6">
          <a href="/admin" class="flex items-center gap-2 group">
            <div class="flex h-6 w-6 items-center justify-center rounded-md bg-gradient-to-br from-electric-600 to-[#0A1020] border border-white/15 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-3.5 w-3.5" fill="none">
                <path d="M18 3L6 17H15L13 29L26 14H17L18 3Z" fill="#38BDF8" stroke="#ffffff" stroke-width="0.75" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-serif text-xs font-medium tracking-tight text-white">EntreTormentas</span>
              <span class="rounded bg-electric-500/15 border border-electric-500/30 px-1 py-0.2 text-[9px] font-mono font-medium text-electric-300">
                BACKOFFICE
              </span>
            </div>
          </a>

          <div class="h-3.5 w-px bg-white/[0.1] hidden sm:block"></div>

          <!-- Navigation Tabs -->
          <nav class="flex items-center gap-1 text-xs">
            <a
              href="/admin"
              class:list={[
                "flex items-center gap-1.5 rounded-md px-2.5 py-1 transition font-medium text-[11px]",
                activeTab === 'entradas'
                  ? "bg-white/[0.08] text-white border border-white/10"
                  : "text-slate-400 hover:text-white hover:bg-white/[0.04]"
              ]}
            >
              <span>📋</span>
              <span>Entradas</span>
            </a>

            <a
              href="/admin/nueva"
              class:list={[
                "flex items-center gap-1.5 rounded-md px-2.5 py-1 transition font-medium text-[11px]",
                activeTab === 'nueva'
                  ? "bg-electric-600 text-white shadow-sm"
                  : "text-slate-400 hover:text-white hover:bg-white/[0.04]"
              ]}
            >
              <span>➕</span>
              <span>Nueva Entrada</span>
            </a>
          </nav>
        </div>

        <!-- Right: Public Portal link + User & Session -->
        <div class="flex items-center gap-3 text-xs">
          <a
            href="/"
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1 text-[11px] text-slate-400 hover:text-white transition"
            title="Abrir portal público en nueva pestaña"
          >
            <span>🌐 Ver portal</span>
            <span class="text-[9px] text-slate-500">↗</span>
          </a>

          <div class="h-3.5 w-px bg-white/[0.1] hidden sm:block"></div>

          <div class="flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-electric-600/20 text-electric-300 border border-electric-500/30 text-[10px] font-medium uppercase">
              {activeUser.name.charAt(0)}
            </div>
            <span class="hidden md:inline text-[11px] text-slate-300 font-medium">
              {activeUser.name}
            </span>
          </div>

          <a
            href="/api/auth/logout"
            class="rounded border border-rose-500/25 bg-rose-500/10 px-2 py-0.5 text-[10px] font-medium text-rose-300 transition hover:bg-rose-500/20"
          >
            Salir
          </a>
        </div>
      </div>
    </header>

    <!-- Backoffice Page Canvas -->
    <div class="flex-1">
      <slot />
    </div>

  </body>
</html>
