---
export const prerender = false;

// URLs heredadas de WordPress (/mi-noticia) → /noticias/mi-noticia.
// No consulta el contenido para que el Worker no cargue las ~9.500 notas:
// si la nota no existe, /noticias/... responde el 404 estático.
const { slug } = Astro.params;

if (!slug || slug.includes('.') || !/^[a-z0-9-]+$/i.test(slug)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

return Astro.redirect(`/noticias/${slug.toLowerCase()}`, 301);
---
