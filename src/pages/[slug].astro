---
export const prerender = false;

import { getEntry } from 'astro:content';

const { slug } = Astro.params;

if (!slug || slug.includes('.')) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Comprobar si el slug corresponde a un artículo mediante búsqueda indexada O(1)
let post = await getEntry('posts', slug);
if (!post) {
  post = await getEntry('posts', `${slug}.md`);
}

if (post) {
  // Redirección permanente 301 a la ruta canónica de noticias para preservar SEO
  return Astro.redirect(`/noticias/${post.id}`, 301);
}

return new Response(null, { status: 404, statusText: 'Not Found' });
---
