---
export const prerender = false;

import { getCollection } from 'astro:content';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Comprobar si el slug corresponde a un artículo
const posts = await getCollection('posts');
const post = posts.find((p) => p.id === slug || p.id === `${slug}.md`);

if (post) {
  // Redirección permanente 301 a la ruta canónica de noticias para preservar SEO
  return Astro.redirect(`/noticias/${post.id}`, 301);
}

return Astro.redirect('/404');
---
