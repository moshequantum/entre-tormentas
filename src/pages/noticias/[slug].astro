---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getActiveAd } from '../../lib/site-settings';
import AdBanner from '../../components/AdBanner.astro';
import { getCollection, getEntry, render } from 'astro:content';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Obtener el artículo directamente por id indexado O(1)
let post = await getEntry('posts', slug);
if (!post) {
  post = await getEntry('posts', `${slug}.md`);
}

if (!post) {
  return Astro.redirect('/404');
}

// Restrict unpublished posts (draft, review, trash) to authenticated editorial staff
const postStatus = post.data.status || 'published';
const isUnpublished = postStatus !== 'published';
if (isUnpublished) {
  const sessionCookie = Astro.cookies.get('entretormentas_session');
  if (!sessionCookie?.value) {
    return Astro.redirect('/404');
  }
}

const { Content } = await render(post);

// Formato de fecha en español de Venezuela
let formattedDate = 'Reciente';
if (post.data.publishedAt) {
  try {
    formattedDate = new Intl.DateTimeFormat('es-VE', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    }).format(new Date(post.data.publishedAt));
  } catch (e) {
    formattedDate = String(post.data.publishedAt);
  }
}

// Categoría con estilo editorial
const categoryLabels: Record<string, { label: string; color: string }> = {
  regionales: { label: 'Regionales (Zulia)', color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' },
  nacionales: { label: 'Nacionales', color: 'bg-blue-500/20 text-blue-400 border-blue-500/30' },
  sucesos: { label: 'Sucesos', color: 'bg-rose-500/20 text-rose-400 border-rose-500/30' },
  deportes: { label: 'Deportes', color: 'bg-amber-500/20 text-amber-400 border-amber-500/30' },
  internacionales: { label: 'Internacionales', color: 'bg-purple-500/20 text-purple-400 border-purple-500/30' },
  espectaculos: { label: 'Espectáculos', color: 'bg-pink-500/20 text-pink-400 border-pink-500/30' },
  opinion: { label: 'Opinión', color: 'bg-cyan-500/20 text-cyan-400 border-cyan-500/30' },
};

const currentCategory = categoryLabels[post.data.category] || {
  label: post.data.category ? post.data.category.toUpperCase() : 'NOTICIAS',
  color: 'bg-storm-700/50 text-slate-300 border-storm-600'
};

// Noticias relacionadas de la misma categoría (excluyendo la actual)
const categoryPosts = await getCollection('posts', ({ data, id }) => data.category === post.data.category && id !== post.id);
const relatedPosts = categoryPosts
  .sort((a, b) => new Date(b.data.publishedAt || 0).getTime() - new Date(a.data.publishedAt || 0).getTime())
  .slice(0, 4);

const coverImage = post.data.coverImage || '/images/posts/default-post.jpg';
const pageUrl = Astro.url.href;

// Cálculo de tiempo estimado de lectura (200 palabras por minuto)
const rawBody = post.body || '';
const wordCount = rawBody.trim() ? rawBody.trim().split(/\s+/).length : 250;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));
const articleTopAd = await getActiveAd('article-top');
const articleBottomAd = await getActiveAd('article-bottom');
---

<Layout
  title={`${post.data.title} | Entre Tormentas`}
  description={post.data.excerpt || post.data.title}
  image={coverImage}
  type="article"
  publishedTime={post.data.publishedAt}
  category={post.data.category}
  author={post.data.author}
>
  <!-- Atmospheric Glow Effect -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[400px] overflow-hidden opacity-25">
    <div class="absolute -top-32 left-1/2 h-[450px] w-[800px] -translate-x-1/2 rounded-full bg-gradient-to-b from-electric-600/30 to-transparent blur-3xl"></div>
  </div>

  <article class="relative mx-auto max-w-4xl px-4 py-8 sm:px-6">
    {isUnpublished && (
      <div class="mb-6 flex items-center justify-between rounded-xl border border-amber-500/30 bg-amber-500/10 p-3.5 text-xs text-amber-200">
        <div class="flex items-center gap-2">
          <span>⚠️</span>
          <span>
            <strong>Vista previa editorial:</strong> Esta nota está en estado <b class="uppercase font-mono text-amber-300">{postStatus}</b> (no es visible para el público general).
          </span>
        </div>
        <a
          href={`/keystatic/collection/posts/item/${slug}`}
          class="rounded bg-amber-500/20 px-2.5 py-1 font-medium hover:bg-amber-500/30 text-white transition"
        >
          Editar en Keystatic →
        </a>
      </div>
    )}

    <!-- Breadcrumb de Navegación -->
    <nav aria-label="Miga de pan" class="mb-6 flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="transition hover:text-white">Inicio</a>
      <span>/</span>
      <a href={`/categoria/${post.data.category}`} class="capitalize transition hover:text-ion-300">
        {post.data.category}
      </a>
      <span>/</span>
      <span class="truncate max-w-[200px] sm:max-w-md text-slate-500" aria-current="page">
        {post.data.title}
      </span>
    </nav>

    <!-- Header del Artículo -->
    <header class="space-y-4 mb-8">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`/categoria/${post.data.category}`}
          class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold tracking-wider uppercase border ${currentCategory.color}`}
        >
          <span class="h-1.5 w-1.5 rounded-full bg-current animate-pulse"></span>
          {currentCategory.label}
        </a>
        <span class="text-xs text-slate-400 font-mono">
          📅 {formattedDate}
        </span>
        <span class="text-xs text-slate-400 font-mono">
          ⏱️ {readingTimeMinutes} min de lectura
        </span>
      </div>

      <h1 class="font-serif text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
        {post.data.title}
      </h1>

      <!-- Metadata del Autor y Redacción -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-y border-storm-800/80 py-3.5 text-xs text-slate-300">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-full bg-electric-600/20 text-ion-300 font-bold border border-electric-500/30">
            ET
          </div>
          <div>
            <div class="font-semibold text-white">Por {post.data.author || 'Redacción Entre Tormentas'}</div>
            <div class="text-[11px] text-slate-400">Diario Digital del Zulia</div>
          </div>
        </div>

        <!-- Botones para Compartir -->
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mr-1 hidden sm:inline">Compartir:</span>
          <!-- WhatsApp -->
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title + ' ' + pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Compartir en WhatsApp"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-storm-700 bg-storm-900 text-emerald-400 transition hover:border-emerald-500 hover:bg-emerald-500/10"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Compartir en X"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-storm-700 bg-storm-900 text-slate-200 transition hover:border-sky-500 hover:bg-sky-500/10"
          >
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Compartir en Facebook"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-storm-700 bg-storm-900 text-blue-400 transition hover:border-blue-500 hover:bg-blue-500/10"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Copiar enlace directo -->
          <button
            type="button"
            id="btn-copy-link"
            aria-label="Copiar enlace de la noticia"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-storm-700 bg-storm-900 text-slate-300 transition hover:border-electric-500 hover:text-white"
            title="Copiar enlace directo"
          >
            <svg id="icon-copy" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10a2 2 0 00-2 2v3a2 2 0 002 2h6a2 2 0 002-2v-3a2 2 0 00-2-2z" />
            </svg>
            <svg id="icon-copied" class="h-4 w-4 text-emerald-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Imagen de Portada Principal con Fallback -->
    <div class="relative mb-8 overflow-hidden rounded-2xl border border-storm-700 bg-storm-900 shadow-2xl">
      <img
        src={coverImage}
        alt={post.data.title}
        class="w-full max-h-[520px] object-cover"
        onerror="this.src='/images/posts/default-post.jpg'"
      />
    </div>

    <!-- Bajada / Extracto Editorial si existe -->
    {post.data.excerpt && (
      <div class="mb-8 rounded-r-xl border-l-4 border-electric-brand bg-storm-900/60 p-5 backdrop-blur-sm">
        <p class="font-serif text-base sm:text-lg italic leading-relaxed text-slate-200">
          «{post.data.excerpt}»
        </p>
      </div>
    )}

    <!-- Publicidad Superior al Cuerpo -->
    <div class="my-8">
      <AdBanner
        image={articleTopAd?.image ?? "/images/ads/banner-header.png"}
        href={articleTopAd?.href ?? "https://sedemat.gob.ve"}
        alt={articleTopAd?.alt ?? "Publicidad Institucional"}
      />
    </div>

    <!-- Contenido Principal en Markdown / Prose -->
    <div class="prose prose-invert prose-lg max-w-none text-slate-200 leading-relaxed font-sans prose-headings:font-serif prose-headings:text-white prose-a:text-ion-400 hover:prose-a:text-white prose-strong:text-white prose-img:rounded-xl prose-img:border prose-img:border-storm-800">
      <Content />
    </div>

    <!-- Espacio Publicitario In-Article (AdSense Fluid / Direct Sponsor con Cero CLS) -->
    <div class="my-10">
      <AdBanner
        slotType="in-article"
        image={articleBottomAd?.image ?? "/images/ads/banner-header.png"}
        href={articleBottomAd?.href ?? "https://sedemat.gob.ve"}
        alt={articleBottomAd?.alt ?? "Publicidad Entre Tormentas"}
      />
    </div>

    <!-- Firma de Redacción -->
    <div class="mt-12 rounded-xl border border-storm-800 bg-storm-900/40 p-6 backdrop-blur-sm">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-electric-brand text-white font-bold text-lg shadow-lg shadow-electric-brand/30">
          ET
        </div>
        <div>
          <div class="text-sm font-bold text-white">Redacción Entre Tormentas</div>
          <div class="text-xs text-slate-400">
            Periodismo independiente, veraz y oportuno desde el Zulia para toda Venezuela y el mundo.
          </div>
        </div>
      </div>
    </div>

    <!-- Noticias Relacionadas -->
    {relatedPosts.length > 0 && (
      <section class="mt-14 border-t border-storm-800 pt-8">
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="h-4 w-1 rounded-full bg-ion-400"></span>
            <h2 class="text-lg font-bold uppercase tracking-wider text-white">
              Más de {currentCategory.label}
            </h2>
          </div>
          <a href={`/categoria/${post.data.category}`} class="text-xs font-semibold text-ion-400 hover:text-white transition">
            Ver todas →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {relatedPosts.map((rel) => (
            <a href={`/noticias/${rel.id}`} class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl">
              <div>
                <div class="relative h-36 w-full overflow-hidden bg-storm-800">
                  <img
                    src={rel.data.coverImage || '/images/posts/default-post.jpg'}
                    alt={rel.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.src='/images/posts/default-post.jpg'"
                  />
                </div>
                <div class="p-3.5 space-y-2">
                  <h3 class="text-xs font-bold leading-snug text-white line-clamp-3 group-hover:text-ion-300 transition-colors">
                    {rel.data.title}
                  </h3>
                </div>
              </div>
              <div class="px-3.5 pb-3 text-[10px] text-slate-400 flex items-center justify-between border-t border-storm-800/80 pt-2">
                <span>{rel.data.publishedAt || 'Reciente'}</span>
                <span class="text-ion-400 font-bold group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <script>
    const btnCopy = document.getElementById('btn-copy-link');
    const iconCopy = document.getElementById('icon-copy');
    const iconCopied = document.getElementById('icon-copied');

    btnCopy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        iconCopy?.classList.add('hidden');
        iconCopied?.classList.remove('hidden');
        setTimeout(() => {
          iconCopy?.classList.remove('hidden');
          iconCopied?.classList.add('hidden');
        }, 2000);
      } catch (err) {
        console.error('Error al copiar enlace:', err);
      }
    });
  </script>
</Layout>
