---
export const prerender = false;

// Disable all caching for backoffice edit screen
Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'no-store');

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getEntry } from 'astro:content';

// Verify authenticated session
const sessionCookie = Astro.cookies.get('entretormentas_session');
if (!sessionCookie?.value) {
  return Astro.redirect('/login');
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/admin');
}

let post = await getEntry('posts', slug);
if (!post) {
  post = await getEntry('posts', `${slug}.md`);
}

if (!post) {
  return Astro.redirect('/admin?error=not_found');
}

const postData = post.data;
const postBody = post.body || '';
const currentStatus = postData.status || 'published';
const formattedDate = postData.publishedAt
  ? new Date(postData.publishedAt).toISOString().split('T')[0]
  : new Date().toISOString().split('T')[0];
---

<AdminLayout title={`Editar: ${postData.title} | EntreTormentas Backoffice`} activeTab="entradas">
  <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 space-y-4">
    
    <!-- Breadcrumb Subheader -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.06] pb-3">
      <div class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/admin" class="hover:text-white transition flex items-center gap-1 font-medium">
          <span>←</span>
          <span>Entradas</span>
        </a>
        <span class="text-slate-600">/</span>
        <span class="text-white font-medium truncate max-w-xs sm:max-w-md">Editar: {postData.title}</span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={`/noticias/${slug}`}
          target="_blank"
          class="inline-flex items-center gap-1 rounded-md border border-white/10 bg-white/[0.04] px-2.5 py-1 text-xs text-slate-300 hover:text-white hover:bg-white/[0.08] transition"
        >
          <span>👁️ Vista previa</span>
          <span class="text-[10px] text-slate-500">↗</span>
        </a>
      </div>
    </div>

    <!-- Main Editorial Workspace -->
    <main>
      
      <!-- Feedback Alert Notice -->
      <div id="publish-alert" class="hidden mb-4 rounded-xl border p-4 text-sm font-medium"></div>

      <form id="form-article">
        <input type="hidden" id="slug" name="slug" value={slug} />

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          
          <!-- MAIN CANVAS: Titular & Editor (8 cols) -->
          <div class="space-y-4 lg:col-span-8">
            
            <!-- Title Box -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-4 sm:p-5 shadow-sm">
              <label for="title" class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 mb-1">
                Titular de la noticia
              </label>
              <input
                id="title"
                name="title"
                type="text"
                required
                value={postData.title}
                placeholder="Añade el título de la noticia..."
                class="w-full bg-transparent font-serif text-2xl sm:text-3xl font-medium text-white placeholder-slate-600 focus:outline-none"
              />
              
              <div class="mt-3 flex flex-wrap items-center gap-2 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-slate-400">
                <span class="text-slate-500">Enlace permanente:</span>
                <span class="text-electric-300">https://www.entretormentas.com/noticias/<span id="slug-preview" class="text-slate-200">{slug}</span></span>
              </div>
            </div>

            <!-- Content Editor Canvas -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] overflow-hidden shadow-sm">
              
              <!-- Formatting Toolbar -->
              <div class="flex flex-wrap items-center gap-1 border-b border-white/[0.08] bg-white/[0.02] px-3 py-2 text-xs text-slate-300">
                <button type="button" class="btn-format rounded px-2.5 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="**" data-suffix="**" title="Negrita"><b>B</b></button>
                <button type="button" class="btn-format rounded px-2.5 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="*" data-suffix="*" title="Cursiva"><i>I</i></button>
                <span class="h-4 w-px bg-white/[0.1] mx-1"></span>
                <button type="button" class="btn-format rounded px-2 py-1 font-serif hover:bg-white/[0.08] hover:text-white" data-prefix="## " data-suffix="" title="Título H2">H2</button>
                <button type="button" class="btn-format rounded px-2 py-1 font-serif hover:bg-white/[0.08] hover:text-white" data-prefix="### " data-suffix="" title="Subtítulo H3">H3</button>
                <span class="h-4 w-px bg-white/[0.1] mx-1"></span>
                <button type="button" class="btn-format rounded px-2 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="> " data-suffix="" title="Cita textual">“ ”</button>
                <button type="button" class="btn-format rounded px-2 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="- " data-suffix="" title="Lista">• Lista</button>
                <button type="button" class="btn-format rounded px-2 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="[" data-suffix="](https://url-del-enlace)" title="Enlace">🔗 Enlace</button>
                <span class="h-4 w-px bg-white/[0.1] mx-1"></span>
                <button
                  type="button"
                  id="btn-insert-body-image"
                  class="flex items-center gap-1.5 rounded-md border border-white/[0.08] bg-white/[0.04] px-2.5 py-1 text-xs text-electric-300 hover:bg-electric-600/10 hover:text-electric-200 transition"
                  title="Subir e insertar imagen dentro de la noticia"
                >
                  <span>🖼️</span>
                  <span>Insertar imagen</span>
                </button>
                <input
                  type="file"
                  id="body-file-input"
                  accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
                  class="hidden"
                />
                <span id="body-upload-indicator" class="hidden text-[11px] text-electric-400 animate-pulse ml-2">
                  ⏳ Subiendo imagen...
                </span>
              </div>

              <!-- Textarea Body -->
              <div class="p-4 sm:p-5">
                <textarea
                  id="content"
                  name="content"
                  required
                  rows="20"
                  placeholder="Desarrollo de la noticia en Markdown..."
                  class="w-full bg-transparent font-sans text-sm leading-relaxed text-slate-100 placeholder-slate-600 focus:outline-none resize-y min-h-[440px]"
                >{postBody}</textarea>
              </div>
            </div>

            <!-- Extracto Editorial (Bajada) -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-4 sm:p-5 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <label for="excerpt" class="block text-xs font-medium uppercase tracking-wider text-slate-300">
                  Extracto / Bajada Editorial
                </label>
                <span class="text-[11px] text-slate-500 font-normal">Resumen de portada y buscadores</span>
              </div>
              <textarea
                id="excerpt"
                name="excerpt"
                rows="3"
                placeholder="Escribí un extracto conciso de la noticia..."
                class="w-full rounded-lg border border-white/[0.08] bg-black/30 p-3 text-xs leading-relaxed text-slate-200 placeholder-slate-600 focus:border-electric-500 focus:outline-none"
              >{postData.excerpt || ''}</textarea>
            </div>
          </div>

          <!-- SIDEBAR: WordPress Publishing Widgets (4 cols) -->
          <div class="space-y-4 lg:col-span-4">
            
            <!-- Widget 1: Estado y Publicación -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-4">
              <div class="flex items-center justify-between border-b border-white/[0.08] pb-3">
                <h3 class="font-serif text-sm font-medium text-white">Publicación</h3>
                <span id="status-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-mono border">
                  {currentStatus === 'published' && '🟢 Publicado'}
                  {currentStatus === 'review' && '🟡 En Revisión'}
                  {currentStatus === 'draft' && '⚪ Borrador'}
                  {currentStatus === 'trash' && '🔴 Papelera'}
                </span>
              </div>

              <!-- Estado selector -->
              <div class="space-y-3 text-xs">
                <div>
                  <label for="status" class="block mb-1 text-[11px] font-medium text-slate-300">
                    Estado de la entrada:
                  </label>
                  <select
                    id="status"
                    name="status"
                    class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-2 text-xs text-white focus:border-electric-500 focus:outline-none"
                  >
                    <option value="published" selected={currentStatus === 'published'}>🟢 Publicado (Visible en el diario)</option>
                    <option value="review" selected={currentStatus === 'review'}>🟡 En Revisión (Aprobación editorial)</option>
                    <option value="draft" selected={currentStatus === 'draft'}>⚪ Borrador (Solo en redacción)</option>
                    <option value="trash" selected={currentStatus === 'trash'}>🔴 Papelera (Reciclaje)</option>
                  </select>
                </div>

                <div class="pt-1">
                  <label for="publishedAt" class="block mb-1 text-[11px] text-slate-400">
                    Fecha de publicación:
                  </label>
                  <input
                    id="publishedAt"
                    name="publishedAt"
                    type="date"
                    value={formattedDate}
                    class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-1.5 text-xs text-white focus:border-electric-500 focus:outline-none"
                  />
                </div>

                <div class="pt-1">
                  <label for="author" class="block mb-1 text-[11px] text-slate-400">
                    Firma / Autor:
                  </label>
                  <input
                    id="author"
                    name="author"
                    type="text"
                    value={postData.author || 'Redacción Entre Tormentas'}
                    class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-1.5 text-xs text-white focus:border-electric-500 focus:outline-none"
                  />
                </div>
              </div>

              <div class="pt-3 border-t border-white/[0.08] space-y-2">
                <button
                  type="submit"
                  id="btn-publish"
                  class="w-full rounded-lg bg-electric-600 hover:bg-electric-500 px-4 py-2.5 text-sm font-medium text-white shadow-md shadow-electric-600/20 transition-all focus:outline-none active:scale-[0.99]"
                >
                  💾 Actualizar cambios
                </button>

                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    id="btn-trash-toggle"
                    class="text-[11px] text-rose-400/80 hover:text-rose-300 transition"
                  >
                    {currentStatus === 'trash' ? '♻️ Restaurar a Borrador' : '🗑️ Mover a la papelera'}
                  </button>

                  {currentStatus === 'trash' && (
                    <button
                      type="button"
                      id="btn-permanent-delete"
                      class="text-[11px] text-rose-500 hover:text-rose-400 font-medium transition underline"
                    >
                      Eliminar permanentemente
                    </button>
                  )}
                </div>
              </div>
            </div>

            <!-- Widget 2: Categorías -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-3">
              <h3 class="font-serif text-sm font-medium text-white border-b border-white/[0.08] pb-2">
                Categorías
              </h3>

              <div class="space-y-2 text-xs text-slate-300 max-h-48 overflow-y-auto pr-1">
                {[
                  { id: 'regionales', label: 'Regionales (Zulia)' },
                  { id: 'deportes', label: 'Deportes' },
                  { id: 'nacionales', label: 'Nacionales' },
                  { id: 'sucesos', label: 'Sucesos' },
                  { id: 'internacionales', label: 'Internacionales' },
                  { id: 'espectaculos', label: 'Espectáculos' },
                  { id: 'opinion', label: 'Opinión' },
                ].map((cat) => (
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input
                      type="radio"
                      name="category"
                      value={cat.id}
                      checked={postData.category?.toLowerCase() === cat.id}
                      class="text-electric-500 focus:ring-0"
                    />
                    <span>{cat.label}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Widget 3: Imagen Destacada (Direct Upload & 16:9 Canvas) -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-3">
              <div class="flex items-center justify-between border-b border-white/[0.08] pb-2">
                <h3 class="font-serif text-sm font-medium text-white">
                  Imagen destacada
                </h3>
                <button type="button" id="btn-clear-image" class="text-[11px] text-slate-500 hover:text-rose-400 transition">
                  Eliminar
                </button>
              </div>

              <!-- Hidden File Input for Direct Upload -->
              <input
                type="file"
                id="cover-file-input"
                accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
                class="hidden"
              />

              <!-- Upload Drag & Drop Zone -->
              <div
                id="drop-zone"
                class="group relative flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-white/15 bg-white/[0.02] p-4 text-center cursor-pointer transition hover:border-electric-400 hover:bg-white/[0.04]"
              >
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-electric-500/10 text-electric-400 mb-2 group-hover:scale-105 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <p class="text-xs font-medium text-slate-200">
                  <span class="text-electric-400 font-semibold underline decoration-electric-500/50 underline-offset-2">Cambiar imagen</span> o arrastrar
                </p>
                <p class="mt-1 text-[10px] text-slate-500">JPG, PNG, WebP hasta 15MB</p>

                <!-- Upload Progress Overlay -->
                <div id="upload-status" class="hidden absolute inset-0 rounded-lg bg-[#0B101D]/90 backdrop-blur-sm flex flex-col items-center justify-center p-3">
                  <div class="h-5 w-5 animate-spin rounded-full border-2 border-electric-500 border-t-transparent mb-2"></div>
                  <span id="upload-status-text" class="text-xs font-medium text-slate-200">Subiendo a Cloudflare R2...</span>
                </div>
              </div>

              <!-- Preview Canvas -->
              <div class="relative aspect-video w-full overflow-hidden rounded-lg border border-white/[0.08] bg-black/40 flex items-center justify-center">
                <img
                  id="image-preview"
                  src={postData.coverImage || '/images/posts/default-post.jpg'}
                  alt="Vista previa de imagen destacada"
                  class="h-full w-full object-cover transition"
                />
                <span id="badge-uploaded" class:list={["absolute top-2 right-2 rounded-md bg-emerald-500/90 backdrop-blur px-2 py-0.5 text-[10px] font-medium text-white shadow", !postData.coverImage && "hidden"]}>
                  ✓ En la nube
                </span>
              </div>

              <!-- Collapsible Manual URL input -->
              <details class="text-[11px] text-slate-400">
                <summary class="cursor-pointer hover:text-slate-200 py-1 transition select-none">
                  O pegar URL manual
                </summary>
                <div class="mt-2 space-y-1">
                  <input
                    id="coverImage"
                    name="coverImage"
                    type="url"
                    value={postData.coverImage || ''}
                    placeholder="https://... o ruta de imagen"
                    class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-1.5 text-xs text-white placeholder-slate-600 focus:border-electric-500 focus:outline-none"
                  />
                  <span class="block text-[10px] text-slate-500">La URL de Cloudflare R2 se actualiza automáticamente al subir.</span>
                </div>
              </details>
            </div>

            <!-- Widget 4: Atributos de Portada -->
            <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-3">
              <h3 class="font-serif text-sm font-medium text-white border-b border-white/[0.08] pb-2">
                Atributos de portada
              </h3>

              <div class="space-y-2.5 text-xs text-slate-300">
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-white">
                  <input
                    type="checkbox"
                    id="isFeatured"
                    name="isFeatured"
                    checked={Boolean(postData.isFeatured)}
                    class="h-4 w-4 rounded border-white/20 bg-black/40 text-electric-600 focus:ring-0"
                  />
                  <span>Fijar en portada (Noticia destacada)</span>
                </label>

                <label class="flex items-center gap-2.5 cursor-pointer hover:text-white">
                  <input
                    type="checkbox"
                    id="isBreaking"
                    name="isBreaking"
                    checked={Boolean(postData.isBreaking)}
                    class="h-4 w-4 rounded border-white/20 bg-black/40 text-amber-500 focus:ring-0"
                  />
                  <span class="text-amber-300/90">Última Hora / Alerta Catatumbo</span>
                </label>
              </div>
            </div>

          </div>
        </div>
      </form>
    </main>
  </div>

  <script>
    const form = document.getElementById('form-article');
    const slugInput = document.getElementById('slug');
    const titleInput = document.getElementById('title');
    const coverImageInput = document.getElementById('coverImage');
    const imagePreview = document.getElementById('image-preview');
    const btnClearImage = document.getElementById('btn-clear-image');
    const dateInput = document.getElementById('publishedAt');
    const alertBox = document.getElementById('publish-alert');
    const btnPublish = document.getElementById('btn-publish');
    const contentArea = document.getElementById('content');
    const statusSelect = document.getElementById('status');
    const btnTrashToggle = document.getElementById('btn-trash-toggle');
    const btnPermanentDelete = document.getElementById('btn-permanent-delete');

    // Image Upload Elements
    const coverFileInput = document.getElementById('cover-file-input');
    const dropZone = document.getElementById('drop-zone');
    const uploadStatus = document.getElementById('upload-status');
    const uploadStatusText = document.getElementById('upload-status-text');
    const badgeUploaded = document.getElementById('badge-uploaded');

    const btnInsertBodyImage = document.getElementById('btn-insert-body-image');
    const bodyFileInput = document.getElementById('body-file-input');
    const bodyUploadIndicator = document.getElementById('body-upload-indicator');

    function getSessionToken() {
      const match = document.cookie.match(/(?:^|;\s*)entretormentas_session=([^;]*)/);
      return match ? decodeURIComponent(match[1]) : '';
    }

    async function uploadImageFile(file) {
      const formData = new FormData();
      formData.append('file', file);

      const token = getSessionToken();
      const headers = token ? { 'Authorization': `Bearer ${token}` } : {};

      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        headers,
        credentials: 'include',
        body: formData,
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Error al subir la imagen.');
      }
      return data;
    }

    dropZone?.addEventListener('click', () => {
      coverFileInput?.click();
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('border-electric-400', 'bg-white/[0.08]');
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('border-electric-400', 'bg-white/[0.08]');
      });
    });

    async function handleCoverFileUpload(file) {
      if (!file || !file.type.startsWith('image/')) {
        alert('Por favor seleccioná un archivo de imagen válido.');
        return;
      }

      const localUrl = URL.createObjectURL(file);
      if (imagePreview) imagePreview.src = localUrl;

      if (uploadStatus) uploadStatus.classList.remove('hidden');
      if (uploadStatusText) uploadStatusText.textContent = 'Subiendo a Cloudflare R2...';

      try {
        const result = await uploadImageFile(file);
        if (coverImageInput) coverImageInput.value = result.url;
        if (imagePreview) imagePreview.src = result.url;
        if (badgeUploaded) badgeUploaded.classList.remove('hidden');
        if (uploadStatusText) uploadStatusText.textContent = '¡Completado!';
        setTimeout(() => {
          if (uploadStatus) uploadStatus.classList.add('hidden');
        }, 500);
      } catch (err) {
        alert('Error al subir imagen: ' + err.message);
        if (uploadStatus) uploadStatus.classList.add('hidden');
      }
    }

    coverFileInput?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (file) handleCoverFileUpload(file);
    });

    dropZone?.addEventListener('drop', (e) => {
      const file = e.dataTransfer?.files?.[0];
      if (file) handleCoverFileUpload(file);
    });

    btnClearImage?.addEventListener('click', () => {
      if (coverImageInput) coverImageInput.value = '';
      if (coverFileInput) coverFileInput.value = '';
      if (imagePreview) imagePreview.src = '/images/posts/default-post.jpg';
      if (badgeUploaded) badgeUploaded.classList.add('hidden');
    });

    // Formatting buttons handler
    document.querySelectorAll('.btn-format').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!contentArea) return;
        const prefix = btn.getAttribute('data-prefix') || '';
        const suffix = btn.getAttribute('data-suffix') || '';
        const start = contentArea.selectionStart;
        const end = contentArea.selectionEnd;
        const selected = contentArea.value.substring(start, end);
        const replacement = prefix + (selected || 'texto') + suffix;
        contentArea.setRangeText(replacement, start, end, 'select');
        contentArea.focus();
      });
    });

    // In-body image upload
    btnInsertBodyImage?.addEventListener('click', () => {
      bodyFileInput?.click();
    });

    bodyFileInput?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      try {
        if (bodyUploadIndicator) bodyUploadIndicator.classList.remove('hidden');
        const result = await uploadImageFile(file);

        if (contentArea) {
          const start = contentArea.selectionStart;
          const end = contentArea.selectionEnd;
          const altName = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
          const imageMd = `\n\n![${altName}](${result.url})\n\n`;
          contentArea.setRangeText(imageMd, start, end, 'end');
          contentArea.focus();
        }
      } catch (err) {
        alert('Error al insertar imagen en el cuerpo: ' + err.message);
      } finally {
        if (bodyUploadIndicator) bodyUploadIndicator.classList.add('hidden');
        if (bodyFileInput) bodyFileInput.value = '';
      }
    });

    // Support paste from clipboard
    contentArea?.addEventListener('paste', async (e) => {
      const items = e.clipboardData?.items;
      if (!items) return;

      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          e.preventDefault();
          const file = items[i].getAsFile();
          if (!file) continue;

          try {
            if (bodyUploadIndicator) {
              bodyUploadIndicator.textContent = '⏳ Subiendo imagen pegada...';
              bodyUploadIndicator.classList.remove('hidden');
            }

            const result = await uploadImageFile(file);

            const start = contentArea.selectionStart;
            const end = contentArea.selectionEnd;
            const imageMd = `\n\n![Imagen](${result.url})\n\n`;
            contentArea.setRangeText(imageMd, start, end, 'end');
            contentArea.focus();
          } catch (err) {
            alert('Error al subir imagen pegada: ' + err.message);
          } finally {
            if (bodyUploadIndicator) {
              bodyUploadIndicator.classList.add('hidden');
              bodyUploadIndicator.textContent = '⏳ Subiendo imagen...';
            }
          }
          break;
        }
      }
    });

    // Trash / Restore toggle action
    btnTrashToggle?.addEventListener('click', async () => {
      const currentSlug = slugInput?.value;
      const currentVal = statusSelect?.value;
      const isTrash = currentVal === 'trash';
      const action = isTrash ? 'restore' : 'trash';

      if (!confirm(isTrash ? '¿Restaurar esta entrada a Borrador?' : '¿Mover esta entrada a la Papelera?')) {
        return;
      }

      try {
        const token = getSessionToken();
        const headers = {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        };

        const res = await fetch('/api/admin/delete', {
          method: 'POST',
          headers,
          credentials: 'include',
          body: JSON.stringify({ slug: currentSlug, action }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert(data.message);
          window.location.href = '/admin';
        } else {
          alert('Error: ' + (data.error || 'No se pudo actualizar'));
        }
      } catch (e) {
        alert('Error de red al actualizar estado.');
      }
    });

    // Permanent delete action
    btnPermanentDelete?.addEventListener('click', async () => {
      const currentSlug = slugInput?.value;
      if (!confirm(`⚠️ ¿ELIMINAR DEFINITIVAMENTE la entrada "${currentSlug}"? Esta acción borrará el archivo de GitHub y no se puede deshacer.`)) {
        return;
      }

      try {
        const token = getSessionToken();
        const headers = {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        };

        const res = await fetch('/api/admin/delete', {
          method: 'POST',
          headers,
          credentials: 'include',
          body: JSON.stringify({ slug: currentSlug, action: 'delete_permanent' }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert(data.message);
          window.location.href = '/admin';
        } else {
          alert('Error: ' + (data.error || 'No se pudo eliminar'));
        }
      } catch (e) {
        alert('Error de red al eliminar.');
      }
    });

    // Form submit handler (Update Post)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const slug = slugInput?.value.trim();
      const title = titleInput?.value.trim();
      const content = contentArea?.value.trim();
      const categoryEl = document.querySelector('input[name="category"]:checked');
      const category = categoryEl ? categoryEl.value : 'regionales';
      const author = document.getElementById('author')?.value;
      const publishedAt = dateInput?.value;
      const coverImage = coverImageInput?.value.trim();
      const excerpt = document.getElementById('excerpt')?.value.trim();
      const status = statusSelect?.value || 'published';
      const isFeatured = document.getElementById('isFeatured')?.checked;
      const isBreaking = document.getElementById('isBreaking')?.checked;

      if (!title || !content) return;

      try {
        if (btnPublish) {
          btnPublish.innerHTML = '<span>⏳ Guardando cambios en el repositorio...</span>';
          btnPublish.setAttribute('disabled', 'true');
        }

        if (alertBox) alertBox.classList.add('hidden');

        const token = getSessionToken();
        const headers = {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        };

        const res = await fetch('/api/admin/publish', {
          method: 'POST',
          headers,
          credentials: 'include',
          body: JSON.stringify({
            slug,
            title,
            content,
            category,
            author,
            publishedAt,
            coverImage,
            excerpt,
            status,
            isFeatured,
            isBreaking,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (alertBox) {
            alertBox.className = 'mb-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-300';
            alertBox.innerHTML = `
              <div class="flex items-center gap-2">
                <span class="text-lg">✅</span>
                <div>
                  <strong>¡Cambios guardados con éxito!</strong>
                  <p class="text-xs mt-1 text-slate-300">
                    Estado actual: <strong class="uppercase font-mono text-emerald-400">${data.status}</strong>. Podés ver la entrada en vivo o continuar editando:
                    <a href="/noticias/${data.slug}" target="_blank" class="text-emerald-400 underline font-mono ml-1">/noticias/${data.slug} ↗</a>
                  </p>
                  <div class="mt-2 flex gap-3 text-xs">
                    <a href="/admin" class="text-white underline font-medium">← Volver al listado de entradas</a>
                  </div>
                </div>
              </div>
            `;
            alertBox.classList.remove('hidden');
          }
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          if (alertBox) {
            alertBox.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-300';
            alertBox.innerHTML = `<strong>Error al guardar:</strong> ${data.error || 'Ocurrió un error inesperado'}`;
            alertBox.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (alertBox) {
          alertBox.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-300';
          alertBox.innerHTML = '<strong>Error de red:</strong> No se pudo conectar con el servidor.';
          alertBox.classList.remove('hidden');
        }
      } finally {
        if (btnPublish) {
          btnPublish.innerHTML = '<span>💾 Actualizar cambios</span>';
          btnPublish.removeAttribute('disabled');
        }
      }
    });
  </script>
</AdminLayout>
