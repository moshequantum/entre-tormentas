---
import { img, IMG_FALLBACK } from '../lib/img';
import Layout from '../layouts/Layout.astro';
import { getActiveAd } from '../lib/site-settings';
import AdBanner from '../components/AdBanner.astro';
import { getCollection } from 'astro:content';

// Obtener y ordenar todas las publicaciones por fecha descendente
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.data.publishedAt || 0).getTime();
  const dateB = new Date(b.data.publishedAt || 0).getTime();
  return dateB - dateA;
});

function formatEditorialDate(value?: string | Date): string {
  if (!value) return 'Reciente';
  const parsed = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(parsed.getTime())) return String(value);
  return new Intl.DateTimeFormat('es-VE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(parsed);
}

function resolveExcerpt(excerpt?: string, body?: string): string {
  if (excerpt && excerpt.trim()) return excerpt.trim();
  if (body && body.trim()) {
    const clean = body
      .replace(/!\[.*?\]\(.*?\)/g, '')
      .replace(/[#*_>`~\\]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
    if (clean) return clean.length > 200 ? `${clean.slice(0, 200).trim()}…` : clean;
  }
  return 'Noticias de actualidad y sucesos en el Zulia.';
}

// 1. Noticia Principal (Lead Hero Story): la primera destacada o la más reciente
const featuredPosts = sortedPosts.filter((p) => p.data.isFeatured);
const leadPost = featuredPosts[0] || sortedPosts[0];

const leadStory = {
  id: leadPost?.id || '',
  title: leadPost?.data.title || 'Entre Tormentas | Diario Digital',
  excerpt: resolveExcerpt(leadPost?.data.excerpt, leadPost?.body),
  category: leadPost?.data.category ? leadPost.data.category.toUpperCase() : 'REGIONALES',
  time: formatEditorialDate(leadPost?.data.publishedAt),
  author: leadPost?.data.author || 'Redacción Entre Tormentas',
  image: leadPost?.data.coverImage || '/images/posts/default-post.jpg',
  slug: leadPost?.id || ''
};

// 2. Sub-Destacadas de Portada (Las demás marcadas como isFeatured por Guillo)
const subFeaturedList = (featuredPosts.length > 1
  ? featuredPosts.filter((p) => p.id !== leadStory.id).slice(0, 3)
  : sortedPosts.filter((p) => p.id !== leadStory.id).slice(0, 3)
).map((p) => ({
  id: p.id,
  title: p.data.title,
  category: (p.data.category || 'REGIONALES').toUpperCase(),
  time: formatEditorialDate(p.data.publishedAt),
  author: p.data.author || 'Redacción',
  image: p.data.coverImage || '/images/posts/default-post.jpg',
  excerpt: resolveExcerpt(p.data.excerpt, p.body),
}));

// 3. Tendencias / Lo Más Leído (4 noticias del ranking lateral)
const trendingRankings = sortedPosts
  .filter((p) => p.id !== leadStory.id && !subFeaturedList.some((sf) => sf.id === p.id))
  .slice(0, 4)
  .map((p, idx) => ({
    id: p.id,
    rank: `0${idx + 1}`,
    title: p.data.title,
    category: (p.data.category || 'REGIONALES').toUpperCase(),
    reads: `${(15 - idx * 2.2).toFixed(1)}k lecturas`
  }));

// 4. Bloque Regionales (Zulia)
const regionalStories = sortedPosts
  .filter((p) => p.data.category === 'regionales' && p.id !== leadStory.id)
  .slice(0, 4)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    category: 'Regionales',
    badgeColor: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
    time: formatEditorialDate(p.data.publishedAt),
    author: p.data.author || 'Redacción',
    image: p.data.coverImage || '/images/posts/default-post.jpg'
  }));

// 5. Bloque Nacionales (Venezuela & Política)
const nationalStories = sortedPosts
  .filter((p) => p.data.category === 'nacionales' && p.id !== leadStory.id)
  .slice(0, 4)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    category: 'Nacionales',
    badgeColor: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
    time: formatEditorialDate(p.data.publishedAt),
    author: p.data.author || 'Redacción',
    image: p.data.coverImage || '/images/posts/default-post.jpg'
  }));

// 6. Bloque Deportes (Águilas, LVBP, Gaiteros, Vinotinto)
const sportsStories = sortedPosts
  .filter((p) => p.data.category === 'deportes' && p.id !== leadStory.id)
  .slice(0, 3)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    category: 'Deportes',
    badgeColor: 'bg-amber-500/20 text-amber-400 border-amber-500/30',
    time: formatEditorialDate(p.data.publishedAt),
    author: p.data.author || 'Deportes ET',
    image: p.data.coverImage || '/images/posts/default-post.jpg'
  }));

// 7. Bloque Sucesos & Seguridad
const sucesosStories = sortedPosts
  .filter((p) => p.data.category === 'sucesos' && p.id !== leadStory.id)
  .slice(0, 3)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    category: 'Sucesos',
    badgeColor: 'bg-rose-500/20 text-rose-400 border-rose-500/30',
    time: formatEditorialDate(p.data.publishedAt),
    author: p.data.author || 'Seguridad',
    image: p.data.coverImage || '/images/posts/default-post.jpg'
  }));

// 8. Sección Opinión & Columnistas
const opinionPieces = sortedPosts
  .filter((p) => p.data.category === 'opinion')
  .slice(0, 2)
  .map((p) => ({
    id: p.id,
    author: p.data.author || 'Columnista Invitado',
    role: 'Firma Editorial',
    title: p.data.title,
    avatar: p.data.coverImage || '/images/brand/isologo-e-concept.jpg'
  }));

const homeAd = await getActiveAd('home');
---

<Layout
  preloadImage={img(leadStory.image, 'hero')}
  title="Entre Tormentas | Diario Digital del Zulia - Noticias y Actualidad"
  description="Primer diario digital de noticias de Maracaibo, Zulia y Venezuela. Información veraz e inmediata sobre regionales, política nacional, sucesos, deportes y opinión."
  type="website"
>

  <!-- Atmospheric Maracaibo Portada Backdrop with Smooth Black Fade -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[580px] overflow-hidden opacity-30">
    <img
      {...img('/images/brand/maracaibo-header-bg.jpg', 'full')}
      alt=""
      aria-hidden="true"
      decoding="async"
      class="h-full w-full object-cover object-top filter brightness-90 contrast-110"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-storm-950/40 via-storm-950/80 to-storm-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-transparent via-storm-950/40 to-storm-950"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-6 sm:px-6">

    <!-- Hero Editorial Grid: Lead Story (8 cols) + Top Ranked (4 cols) -->
    <section class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      
      <!-- Lead Hero Article -->
      <div class="lg:col-span-8">
        <a href={`/noticias/${leadStory.id}`} class="group block">
          <article class="relative flex min-h-[480px] flex-col justify-end overflow-hidden rounded-2xl border border-storm-700 bg-storm-900 shadow-2xl transition-all duration-300 hover:border-electric-500 hover:shadow-electric-600/20 sm:min-h-[540px]">
            <!-- Image with Atmospheric Vignette -->
            <img
              {...img(leadStory.image, 'hero')}
              alt={leadStory.title}
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              onerror={IMG_FALLBACK}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-storm-950 via-storm-950/75 to-transparent"></div>
            
            <!-- Category & Badge Header -->
            <div class="absolute top-6 left-6 flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-electric-600/90 px-3 py-1 text-xs font-bold tracking-wider text-white uppercase backdrop-blur-md shadow-lg shadow-electric-600/30">
                <span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>
                {leadStory.category}
              </span>
              <span class="rounded-full bg-storm-950/80 px-2.5 py-1 text-[11px] font-semibold text-ion-300 backdrop-blur-md border border-storm-700">
                Noticia Principal
              </span>
            </div>

            <!-- Content Block -->
            <div class="relative z-10 p-6 sm:p-10 space-y-4">
              <div class="flex items-center gap-3 text-xs text-slate-300 font-medium">
                <span class="text-ion-400">⚡ {leadStory.time}</span>
                <span>·</span>
                <span>Por {leadStory.author}</span>
              </div>

              <h1 class="font-sans text-2xl font-extrabold leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl group-hover:text-ion-300 transition-colors">
                {leadStory.title}
              </h1>

              <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl line-clamp-3">
                {leadStory.excerpt}
              </p>

              <div class="pt-2">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-ion-400 transition-all group-hover:gap-3 group-hover:text-white">
                  Leer artículo completo <span>→</span>
                </span>
              </div>
            </div>
          </article>
        </a>
      </div>

      <!-- Trending / Lo Más Leído (4 cols) -->
      <aside class="flex flex-col justify-between rounded-2xl border border-storm-800 bg-storm-900/60 p-6 backdrop-blur-sm lg:col-span-4">
        <div>
          <div class="mb-5 flex items-center justify-between border-b border-storm-800 pb-3">
            <div class="flex items-center gap-2">
              <span class="text-ion-400 text-lg">🔥</span>
              <h3 class="text-sm font-bold tracking-wider text-white uppercase">
                Tendencias · Lo Más Leído
              </h3>
            </div>
            <span class="rounded bg-storm-800 px-2 py-0.5 text-[10px] font-bold text-slate-400 uppercase">24 Horas</span>
          </div>

          <div class="space-y-4 divide-y divide-storm-800/60">
            {trendingRankings.map((trend) => (
              <a href={`/noticias/${trend.id}`} class="group block pt-4 first:pt-0 transition">
                <div class="flex items-start gap-4">
                  <span class="font-display text-2xl font-extrabold tracking-tighter text-storm-700 transition group-hover:text-ion-400">
                    {trend.rank}
                  </span>
                  <div class="space-y-1">
                    <span class="text-[10px] font-bold tracking-wider text-ion-400 uppercase">
                      {trend.category}
                    </span>
                    <h4 class="text-xs sm:text-sm font-semibold leading-snug text-slate-200 transition group-hover:text-white line-clamp-2">
                      {trend.title}
                    </h4>
                    <span class="text-[10px] text-slate-500">{trend.reads}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Catatumbo Live Telemetry Widget -->
        <div class="mt-6 rounded-xl border border-storm-700/80 bg-gradient-to-br from-storm-950 to-storm-900 p-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-electric-600/20 text-ion-400 border border-electric-500/30">
                ⚡
              </div>
              <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Cuenca del Catatumbo</div>
                <div class="text-xs font-bold text-white">Actividad Eléctrica: Alta</div>
              </div>
            </div>
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
        </div>
      </aside>

    </section>

    <!-- Sub-Destacadas de Portada (Grid de 3 columnas para notas marcadas como destacadas) -->
    {subFeaturedList.length > 0 && (
      <section class="mt-10">
        <div class="mb-4 flex items-center justify-between border-b border-storm-800/80 pb-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-ion-400 uppercase tracking-widest">★ Destacadas de la Redacción</span>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {subFeaturedList.map((story) => (
            <a href={`/noticias/${story.id}`} class="block h-full">
              <article class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl h-full border border-storm-800/80 hover:border-electric-500 transition-all">
                <div>
                  <div class="relative h-48 w-full overflow-hidden bg-storm-900">
                    <img
                      {...img(story.image, 'card')}
                      alt={story.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      onerror={IMG_FALLBACK}
                    />
                    <span class="absolute top-3 left-3 rounded-full bg-electric-600/90 px-2.5 py-0.5 text-[10px] font-bold uppercase text-white shadow-md">
                      {story.category}
                    </span>
                  </div>
                  <div class="p-4 space-y-2">
                    <h3 class="text-sm font-bold leading-snug text-white line-clamp-3 group-hover:text-ion-300 transition-colors">
                      {story.title}
                    </h3>
                    <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                      {story.excerpt}
                    </p>
                  </div>
                </div>
                <div class="flex items-center justify-between border-t border-storm-800/80 px-4 py-2.5 text-[11px] text-slate-400 mt-auto">
                  <span>{story.author}</span>
                  <span>{story.time}</span>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Separador Publicitario Responsive (AdSense Leaderboard con Cero CLS) -->
    <div class="my-10">
      <AdBanner
        slotType="leaderboard"
        image={homeAd?.image ?? "/images/ads/banner-header.png"}
        href={homeAd?.href ?? "https://sedemat.gob.ve"}
        alt={homeAd?.alt ?? "Publicidad Entre Tormentas"}
      />
    </div>

    <!-- Section 2: Regionales & Zulia -->
    <section class="mt-12">
      <div class="mb-6 flex items-center justify-between border-b border-storm-800 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="h-4 w-1 rounded-full bg-emerald-400"></span>
          <h2 class="text-lg font-bold tracking-tight text-white uppercase sm:text-xl">
            Regionales · Maracaibo & Zulia
          </h2>
        </div>
        <a href="/categoria/regionales" class="text-xs font-semibold text-ion-400 transition hover:text-white">
          Ver más de Zulia →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {regionalStories.map((story) => (
          <a href={`/noticias/${story.id}`} class="block h-full">
            <article class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl h-full">
              <div>
                <div class="relative h-44 w-full overflow-hidden bg-storm-800">
                  <img
                    {...img(story.image, 'card')}
                    alt={story.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    onerror={IMG_FALLBACK}
                  />
                  <span class={`absolute top-3 left-3 rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase backdrop-blur-md border ${story.badgeColor}`}>
                    {story.category}
                  </span>
                </div>
                <div class="p-4 space-y-2">
                  <h3 class="text-sm font-bold leading-snug text-white line-clamp-3 group-hover:text-ion-300 transition-colors">
                    {story.title}
                  </h3>
                </div>
              </div>
              <div class="flex items-center justify-between border-t border-storm-800/80 px-4 py-3 text-[11px] text-slate-400 mt-auto">
                <span>{story.author}</span>
                <span>{story.time}</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>

    <!-- Section 3: Nacionales & Política -->
    {nationalStories.length > 0 && (
      <section class="mt-14">
        <div class="mb-6 flex items-center justify-between border-b border-storm-800 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="h-4 w-1 rounded-full bg-blue-400"></span>
            <h2 class="text-lg font-bold tracking-tight text-white uppercase sm:text-xl">
              Nacionales · Venezuela & Política
            </h2>
          </div>
          <a href="/categoria/nacionales" class="text-xs font-semibold text-ion-400 transition hover:text-white">
            Ver más nacionales →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {nationalStories.map((story) => (
            <a href={`/noticias/${story.id}`} class="block h-full">
              <article class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl h-full">
                <div>
                  <div class="relative h-44 w-full overflow-hidden bg-storm-800">
                    <img
                      {...img(story.image, 'card')}
                      alt={story.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      onerror={IMG_FALLBACK}
                    />
                    <span class={`absolute top-3 left-3 rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase backdrop-blur-md border ${story.badgeColor}`}>
                      {story.category}
                    </span>
                  </div>
                  <div class="p-4 space-y-2">
                    <h3 class="text-sm font-bold leading-snug text-white line-clamp-3 group-hover:text-ion-300 transition-colors">
                      {story.title}
                    </h3>
                  </div>
                </div>
                <div class="flex items-center justify-between border-t border-storm-800/80 px-4 py-3 text-[11px] text-slate-400 mt-auto">
                  <span>{story.author}</span>
                  <span>{story.time}</span>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Section 4: Deportes & Sucesos (Doble Columna) -->
    <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Deportes (7 cols) -->
      <section class="lg:col-span-7">
        <div class="mb-6 flex items-center justify-between border-b border-storm-800 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="h-4 w-1 rounded-full bg-amber-400"></span>
            <h2 class="text-lg font-bold tracking-tight text-white uppercase sm:text-xl">
              Deportes · Águilas & Pasión
            </h2>
          </div>
          <a href="/categoria/deportes" class="text-xs font-semibold text-ion-400 transition hover:text-white">
            Ver más deportes →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {sportsStories.map((story) => (
            <a href={`/noticias/${story.id}`} class="block h-full">
              <article class="card-storm group flex flex-col justify-between overflow-hidden rounded-xl h-full border border-storm-800">
                <div>
                  <div class="relative h-32 w-full overflow-hidden bg-storm-800">
                    <img
                      {...img(story.image, 'card')}
                      alt={story.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      onerror={IMG_FALLBACK}
                    />
                    <span class={`absolute top-2 left-2 rounded-full px-2 py-0.5 text-[9px] font-bold uppercase backdrop-blur-md border ${story.badgeColor}`}>
                      {story.category}
                    </span>
                  </div>
                  <div class="p-3">
                    <h3 class="text-xs font-bold leading-snug text-white line-clamp-2 group-hover:text-ion-300 transition-colors">
                      {story.title}
                    </h3>
                  </div>
                </div>
                <div class="border-t border-storm-800/80 px-3 py-2 text-[10px] text-slate-400">
                  <span>{story.time}</span>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>

      <!-- Sucesos (5 cols) -->
      <section class="lg:col-span-5">
        <div class="mb-6 flex items-center justify-between border-b border-storm-800 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="h-4 w-1 rounded-full bg-rose-500"></span>
            <h2 class="text-lg font-bold tracking-tight text-white uppercase sm:text-xl">
              Sucesos & Seguridad
            </h2>
          </div>
          <a href="/categoria/sucesos" class="text-xs font-semibold text-ion-400 transition hover:text-white">
            Ver sucesos →
          </a>
        </div>

        <div class="space-y-3">
          {sucesosStories.map((story) => (
            <a href={`/noticias/${story.id}`} class="block group">
              <article class="flex gap-3 rounded-xl border border-storm-800/80 bg-storm-900/60 p-3 hover:border-rose-500/40 transition">
                <img
                  {...img(story.image, 'card')}
                  alt={story.title}
                  class="h-16 w-20 flex-shrink-0 rounded-lg object-cover bg-storm-800"
                  loading="lazy"
                  onerror={IMG_FALLBACK}
                />
                <div class="flex flex-col justify-between space-y-1">
                  <h3 class="text-xs font-semibold text-slate-200 group-hover:text-white line-clamp-2 leading-snug">
                    {story.title}
                  </h3>
                  <div class="flex items-center gap-2 text-[10px] text-slate-400">
                    <span class="text-rose-400">🚨 Sucesos</span>
                    <span>·</span>
                    <span>{story.time}</span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- CTA para Explorar Todo el Archivo de Noticias -->
    <div class="mt-14 rounded-2xl border border-storm-800 bg-gradient-to-r from-storm-950 via-storm-900 to-storm-950 p-6 sm:p-8 text-center">
      <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight">
        ¿Buscás más noticias y cobertura histórica?
      </h3>
      <p class="mt-1 text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
        Accedé a nuestro archivo completo de más de {allPosts.length.toLocaleString('es-VE')} artículos organizados por fecha y categoría.
      </p>
      <div class="mt-5">
        <a
          href="/noticias"
          class="inline-flex items-center gap-2 rounded-xl bg-electric-600 px-6 py-2.5 text-xs font-bold text-white uppercase tracking-wider shadow-lg shadow-electric-600/30 transition-all hover:bg-electric-500 hover:gap-3"
        >
          Ver Todas las Noticias del Archivo <span>→</span>
        </a>
      </div>
    </div>

    <!-- Section 5: Opinión Editorial & Firmas -->
    {opinionPieces.length > 0 && (
      <section class="mt-14 rounded-2xl border border-storm-800 bg-storm-900/40 p-6 sm:p-8 backdrop-blur-sm">
        <div class="mb-6 flex items-center justify-between border-b border-storm-800 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="h-4 w-1 rounded-full bg-electric-500"></span>
            <h2 class="text-lg font-bold tracking-tight text-white uppercase sm:text-xl">
              Opinión & Columnistas
            </h2>
          </div>
          <a href="/categoria/opinion" class="text-xs text-ion-400 hover:text-white transition">
            Voces de la Región →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {opinionPieces.map((col) => (
            <a href={`/noticias/${col.id}`} class="block">
              <article class="card-storm flex gap-4 rounded-xl p-5 transition hover:border-electric-500 h-full">
                <img
                  {...img(col.avatar, 'thumb')}
                  alt={col.author}
                  class="h-14 w-14 flex-shrink-0 rounded-full object-cover border-2 border-storm-700"
                  onerror={IMG_FALLBACK}
                />
                <div class="space-y-1.5">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-white">{col.author}</span>
                    <span class="text-[10px] text-ion-400">· {col.role}</span>
                  </div>
                  <h3 class="text-sm font-semibold leading-snug text-slate-300 transition hover:text-white line-clamp-2">
                    «{col.title}»
                  </h3>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
