---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Verify authenticated session
const sessionCookie = Astro.cookies.get('entretormentas_session');
if (!sessionCookie?.value) {
  return Astro.redirect('/login');
}

const userCookie = Astro.cookies.get('entretormentas_user');
let activeUser = { email: 'Redactor Autorizado', name: 'Periodista' };
try {
  if (userCookie?.value) {
    activeUser = JSON.parse(userCookie.value);
  }
} catch (e) {}

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.publishedAt || 0).getTime() - new Date(a.data.publishedAt || 0).getTime())
  .slice(0, 20);
---

<Layout title="EntreTormentas CMS | Panel Editorial">
  <div class="min-h-screen bg-[#070A11] text-slate-200">
    
    <!-- Top WordPress-Style Administration Bar -->
    <header class="sticky top-0 z-40 border-b border-white/[0.08] bg-[#0B101D]/95 px-4 py-2.5 backdrop-blur-md shadow-sm">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        
        <!-- Left: Branding & Quick WP Links -->
        <div class="flex items-center gap-6">
          <a href="/" target="_blank" class="flex items-center gap-2.5 text-slate-100 hover:text-white transition">
            <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-electric-600 to-[#0A1020] border border-white/15 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-4 w-4" fill="none">
                <path d="M18 3L6 17H15L13 29L26 14H17L18 3Z" fill="#38BDF8" stroke="#ffffff" stroke-width="0.75" />
              </svg>
            </div>
            <span class="font-serif text-sm font-semibold tracking-tight">Entre Tormentas</span>
          </a>

          <!-- Navigation Tabs (WP Style) -->
          <nav class="hidden sm:flex items-center gap-1 text-xs font-medium">
            <button
              type="button"
              id="tab-btn-editor"
              class="tab-nav-btn active flex items-center gap-1.5 rounded-md px-3 py-1.5 transition text-white bg-white/[0.08] border border-white/10"
            >
              <span>✏️</span>
              <span>Añadir nueva entrada</span>
            </button>

            <button
              type="button"
              id="tab-btn-posts"
              class="tab-nav-btn flex items-center gap-1.5 rounded-md px-3 py-1.5 transition text-slate-400 hover:text-white hover:bg-white/[0.04]"
            >
              <span>📋</span>
              <span>Todas las entradas <span class="ml-1 rounded-full bg-white/10 px-1.5 py-0.2 text-[10px] text-slate-300">{allPosts.length}</span></span>
            </button>

            <a
              href="/"
              target="_blank"
              class="flex items-center gap-1 rounded-md px-3 py-1.5 text-slate-400 hover:text-white hover:bg-white/[0.04] transition"
            >
              <span>🌐</span>
              <span>Visitar el sitio</span>
            </a>
          </nav>
        </div>

        <!-- Right: Active User Profile & Logout -->
        <div class="flex items-center gap-4 text-xs font-medium">
          <div class="flex items-center gap-2">
            <div class="flex h-7 w-7 items-center justify-center rounded-full bg-electric-600/20 text-electric-300 border border-electric-500/30 font-bold uppercase text-[11px]">
              {activeUser.name.charAt(0)}
            </div>
            <div class="hidden sm:block text-left">
              <span class="text-slate-400 text-[11px] block">Hola, <strong class="text-white font-medium">{activeUser.name}</strong></span>
            </div>
          </div>

          <a
            href="/api/auth/logout"
            class="rounded-md border border-rose-500/30 bg-rose-500/10 px-2.5 py-1 text-[11px] font-medium text-rose-300 transition hover:bg-rose-500/20"
          >
            Cerrar sesión
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
      
      <!-- Feedback Alert Notice -->
      <div id="publish-alert" class="hidden mb-6 rounded-xl border p-4 text-sm font-medium"></div>

      <!-- VIEW 1: WORDPRESS-STYLE EDITORIAL CANVAS -->
      <div id="view-editor" class="space-y-6">
        <form id="form-article">
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
            
            <!-- MAIN CANVAS: Titular & Editor (8 cols) -->
            <div class="space-y-6 lg:col-span-8">
              
              <!-- Title Box -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm">
                <input
                  id="title"
                  name="title"
                  type="text"
                  required
                  placeholder="Añade el título de la noticia..."
                  class="w-full bg-transparent font-serif text-2xl sm:text-3xl font-medium text-white placeholder-slate-600 focus:outline-none"
                />
                
                <div class="mt-3 flex flex-wrap items-center gap-2 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-slate-400">
                  <span class="text-slate-500">Enlace permanente:</span>
                  <span class="text-electric-300">https://www.entretormentas.com/noticias/<span id="slug-preview" class="text-slate-300">tu-noticia-aqui</span></span>
                </div>
              </div>

              <!-- Content Editor Canvas (WordPress Classic / Gutenberg style) -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] overflow-hidden shadow-sm">
                
                <!-- Formatting Toolbar -->
                <div class="flex flex-wrap items-center gap-1 border-b border-white/[0.08] bg-white/[0.02] px-3 py-2 text-xs text-slate-300">
                  <button type="button" class="btn-format rounded px-2.5 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="**" data-suffix="**" title="Negrita"><b>B</b></button>
                  <button type="button" class="btn-format rounded px-2.5 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="*" data-suffix="*" title="Cursiva"><i>I</i></button>
                  <span class="h-4 w-px bg-white/[0.1] mx-1"></span>
                  <button type="button" class="btn-format rounded px-2 py-1 font-serif hover:bg-white/[0.08] hover:text-white" data-prefix="## " data-suffix="" title="Título H2">H2</button>
                  <button type="button" class="btn-format rounded px-2 py-1 font-serif hover:bg-white/[0.08] hover:text-white" data-prefix="### " data-suffix="" title="Subtítulo H3">H3</button>
                  <span class="h-4 w-px bg-white/[0.1] mx-1"></span>
                  <button type="button" class="btn-format rounded px-2 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="> " data-suffix="" title="Cita textual">“ ”</button>
                  <button type="button" class="btn-format rounded px-2 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="- " data-suffix="" title="Lista">• Lista</button>
                  <button type="button" class="btn-format rounded px-2 py-1 hover:bg-white/[0.08] hover:text-white" data-prefix="[" data-suffix="](https://url-del-enlace)" title="Enlace">🔗 Enlace</button>
                </div>

                <!-- Textarea Body -->
                <div class="p-4 sm:p-5">
                  <textarea
                    id="content"
                    name="content"
                    required
                    rows="16"
                    placeholder="Empezá a escribir el desarrollo de la noticia aquí. Podés agregar párrafos, subtítulos con ## o listas..."
                    class="w-full bg-transparent font-sans text-sm leading-relaxed text-slate-100 placeholder-slate-600 focus:outline-none resize-y min-h-[360px]"
                  ></textarea>
                </div>
              </div>

              <!-- Extracto Editorial (Bajada de la noticia) -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm">
                <div class="flex items-center justify-between mb-2">
                  <label for="excerpt" class="block text-xs font-medium uppercase tracking-wider text-slate-300">
                    Extracto / Bajada Editorial
                  </label>
                  <span class="text-[11px] text-slate-500 font-normal">Resumen de portada y motores de búsqueda</span>
                </div>
                <textarea
                  id="excerpt"
                  name="excerpt"
                  rows="3"
                  placeholder="Escribí un extracto conciso de la noticia (1 a 2 oraciones)..."
                  class="w-full rounded-lg border border-white/[0.08] bg-black/30 p-3 text-xs leading-relaxed text-slate-200 placeholder-slate-600 focus:border-electric-500 focus:outline-none"
                ></textarea>
              </div>
            </div>

            <!-- SIDEBAR: WordPress Publishing Widgets (4 cols) -->
            <div class="space-y-6 lg:col-span-4">
              
              <!-- Widget 1: Publicar -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-white/[0.08] pb-3">
                  <h3 class="font-serif text-sm font-medium text-white">Publicar</h3>
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-mono text-emerald-400 border border-emerald-500/20">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                    En línea
                  </span>
                </div>

                <div class="space-y-3 text-xs text-slate-400">
                  <div class="flex items-center justify-between">
                    <span>Estado:</span>
                    <strong class="text-slate-200 font-medium">Publicado de inmediato</strong>
                  </div>

                  <div class="flex items-center justify-between">
                    <span>Visibilidad:</span>
                    <strong class="text-slate-200 font-medium">Público</strong>
                  </div>

                  <div class="pt-2">
                    <label for="publishedAt" class="block mb-1 text-[11px] text-slate-400">
                      Fecha de publicación:
                    </label>
                    <input
                      id="publishedAt"
                      name="publishedAt"
                      type="date"
                      class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-1.5 text-xs text-white focus:border-electric-500 focus:outline-none"
                    />
                  </div>

                  <div class="pt-1">
                    <label for="author" class="block mb-1 text-[11px] text-slate-400">
                      Firma / Autor:
                    </label>
                    <input
                      id="author"
                      name="author"
                      type="text"
                      value="Redacción Entre Tormentas"
                      class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-1.5 text-xs text-white focus:border-electric-500 focus:outline-none"
                    />
                  </div>
                </div>

                <div class="pt-3 border-t border-white/[0.08]">
                  <button
                    type="submit"
                    id="btn-publish"
                    class="w-full rounded-lg bg-electric-600 hover:bg-electric-500 px-4 py-2.5 text-sm font-medium text-white shadow-md shadow-electric-600/20 transition-all focus:outline-none active:scale-[0.99]"
                  >
                    🚀 Publicar entrada
                  </button>
                </div>
              </div>

              <!-- Widget 2: Categorías (WordPress Radio / Select) -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-3">
                <h3 class="font-serif text-sm font-medium text-white border-b border-white/[0.08] pb-2">
                  Categorías
                </h3>

                <div class="space-y-2 text-xs text-slate-300 max-h-48 overflow-y-auto pr-1">
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="regionales" checked class="text-electric-500 focus:ring-0" />
                    <span>Regionales (Zulia)</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="deportes" class="text-electric-500 focus:ring-0" />
                    <span>Deportes</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="nacionales" class="text-electric-500 focus:ring-0" />
                    <span>Nacionales</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="sucesos" class="text-electric-500 focus:ring-0" />
                    <span>Sucesos</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="internacionales" class="text-electric-500 focus:ring-0" />
                    <span>Internacionales</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="espectaculos" class="text-electric-500 focus:ring-0" />
                    <span>Espectáculos</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-white">
                    <input type="radio" name="category" value="opinion" class="text-electric-500 focus:ring-0" />
                    <span>Opinión</span>
                  </label>
                </div>
              </div>

              <!-- Widget 3: Imagen Destacada (WordPress Featured Image) -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-3">
                <div class="flex items-center justify-between border-b border-white/[0.08] pb-2">
                  <h3 class="font-serif text-sm font-medium text-white">
                    Imagen destacada
                  </h3>
                  <button type="button" id="btn-clear-image" class="text-[11px] text-slate-500 hover:text-rose-400 transition">
                    Eliminar
                  </button>
                </div>

                <!-- URL input -->
                <div>
                  <input
                    id="coverImage"
                    name="coverImage"
                    type="url"
                    placeholder="https://... o ruta de imagen"
                    class="w-full rounded-lg border border-white/[0.08] bg-black/40 px-3 py-1.5 text-xs text-white placeholder-slate-600 focus:border-electric-500 focus:outline-none"
                  />
                  <span class="mt-1 block text-[10px] text-slate-500">Cloudflare R2 o imagen externa</span>
                </div>

                <!-- Subtle Clean Preview Canvas (No eye-burning colors) -->
                <div class="relative aspect-video w-full overflow-hidden rounded-lg border border-dashed border-white/[0.12] bg-black/40 flex items-center justify-center">
                  <img
                    id="image-preview"
                    src="/images/posts/default-post.jpg"
                    alt="Vista previa de imagen destacada"
                    class="h-full w-full object-cover"
                  />
                </div>
              </div>

              <!-- Widget 4: Opciones de Portada -->
              <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] p-5 shadow-sm space-y-3">
                <h3 class="font-serif text-sm font-medium text-white border-b border-white/[0.08] pb-2">
                  Atributos de portada
                </h3>

                <div class="space-y-2.5 text-xs text-slate-300">
                  <label class="flex items-center gap-2.5 cursor-pointer hover:text-white">
                    <input type="checkbox" id="isFeatured" name="isFeatured" class="h-4 w-4 rounded border-white/20 bg-black/40 text-electric-600 focus:ring-0" />
                    <span>Fijar en portada (Noticia destacada)</span>
                  </label>

                  <label class="flex items-center gap-2.5 cursor-pointer hover:text-white">
                    <input type="checkbox" id="isBreaking" name="isBreaking" class="h-4 w-4 rounded border-white/20 bg-black/40 text-amber-500 focus:ring-0" />
                    <span class="text-amber-300/90">Última Hora / Alerta Catatumbo</span>
                  </label>
                </div>
              </div>

            </div>
          </div>
        </form>
      </div>

      <!-- VIEW 2: WORDPRESS-STYLE ALL POSTS TABLE (Entradas Recientes) -->
      <div id="view-posts" class="hidden space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="font-serif text-xl font-medium text-white">Todas las entradas</h2>
            <p class="text-xs text-slate-400">Total de publicaciones en el portal: {allPosts.length} artículos</p>
          </div>

          <button
            type="button"
            id="btn-goto-editor"
            class="rounded-lg bg-electric-600 hover:bg-electric-500 px-4 py-2 text-xs font-medium text-white transition"
          >
            + Añadir nueva entrada
          </button>
        </div>

        <!-- Posts Table -->
        <div class="rounded-xl border border-white/[0.08] bg-[#0B101D] overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
              <thead class="border-b border-white/[0.08] bg-white/[0.02] text-[11px] uppercase tracking-wider text-slate-400">
                <tr>
                  <th class="px-4 py-3">Título</th>
                  <th class="px-4 py-3">Autor</th>
                  <th class="px-4 py-3">Categoría</th>
                  <th class="px-4 py-3">Fecha</th>
                  <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/[0.04]">
                {recentPosts.map((post) => (
                  <tr class="hover:bg-white/[0.02] transition">
                    <td class="px-4 py-3 font-medium text-slate-100 max-w-md">
                      <a href={`/noticias/${post.id}`} target="_blank" class="hover:text-electric-300 transition line-clamp-1">
                        {post.data.title}
                      </a>
                    </td>
                    <td class="px-4 py-3 text-slate-400 whitespace-nowrap">
                      {post.data.author || 'Redacción'}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      <span class="rounded bg-white/[0.05] border border-white/[0.08] px-2 py-0.5 text-[10px] text-slate-300 uppercase">
                        {post.data.category}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-slate-400 whitespace-nowrap">
                      {post.data.publishedAt ? new Date(post.data.publishedAt).toLocaleDateString('es-VE') : 'Reciente'}
                    </td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <a
                        href={`/noticias/${post.id}`}
                        target="_blank"
                        class="text-electric-400 hover:text-electric-300 underline font-medium"
                      >
                        Ver entrada ↗
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script>
    // Tab switching (Editor vs Posts Table)
    const tabEditor = document.getElementById('tab-btn-editor');
    const tabPosts = document.getElementById('tab-btn-posts');
    const viewEditor = document.getElementById('view-editor');
    const viewPosts = document.getElementById('view-posts');
    const btnGotoEditor = document.getElementById('btn-goto-editor');

    function switchView(view) {
      if (view === 'editor') {
        viewEditor?.classList.remove('hidden');
        viewPosts?.classList.add('hidden');
        tabEditor?.classList.add('text-white', 'bg-white/[0.08]', 'border', 'border-white/10');
        tabEditor?.classList.remove('text-slate-400');
        tabPosts?.classList.remove('text-white', 'bg-white/[0.08]', 'border', 'border-white/10');
        tabPosts?.classList.add('text-slate-400');
      } else {
        viewEditor?.classList.add('hidden');
        viewPosts?.classList.remove('hidden');
        tabPosts?.classList.add('text-white', 'bg-white/[0.08]', 'border', 'border-white/10');
        tabPosts?.classList.remove('text-slate-400');
        tabEditor?.classList.remove('text-white', 'bg-white/[0.08]', 'border', 'border-white/10');
        tabEditor?.classList.add('text-slate-400');
      }
    }

    tabEditor?.addEventListener('click', () => switchView('editor'));
    tabPosts?.addEventListener('click', () => switchView('posts'));
    btnGotoEditor?.addEventListener('click', () => switchView('editor'));

    // Form logic
    const form = document.getElementById('form-article');
    const titleInput = document.getElementById('title');
    const slugPreview = document.getElementById('slug-preview');
    const coverImageInput = document.getElementById('coverImage');
    const imagePreview = document.getElementById('image-preview');
    const btnClearImage = document.getElementById('btn-clear-image');
    const dateInput = document.getElementById('publishedAt');
    const alertBox = document.getElementById('publish-alert');
    const btnPublish = document.getElementById('btn-publish');
    const contentArea = document.getElementById('content');

    // Default to today
    if (dateInput) {
      dateInput.value = new Date().toISOString().split('T')[0];
    }

    // Slug generator preview
    function generateSlug(text) {
      return text
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    titleInput?.addEventListener('input', () => {
      const slug = generateSlug(titleInput.value);
      if (slugPreview) slugPreview.textContent = slug || 'tu-noticia-aqui';
    });

    // Image preview handler
    coverImageInput?.addEventListener('input', () => {
      const url = coverImageInput.value.trim();
      if (imagePreview) {
        imagePreview.src = url || '/images/posts/default-post.jpg';
      }
    });

    btnClearImage?.addEventListener('click', () => {
      if (coverImageInput) coverImageInput.value = '';
      if (imagePreview) imagePreview.src = '/images/posts/default-post.jpg';
    });

    // Formatting buttons handler
    document.querySelectorAll('.btn-format').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!contentArea) return;
        const prefix = btn.getAttribute('data-prefix') || '';
        const suffix = btn.getAttribute('data-suffix') || '';
        const start = contentArea.selectionStart;
        const end = contentArea.selectionEnd;
        const selected = contentArea.value.substring(start, end);
        const replacement = prefix + (selected || 'texto') + suffix;
        contentArea.setRangeText(replacement, start, end, 'select');
        contentArea.focus();
      });
    });

    // Form submit handler
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const title = titleInput?.value.trim();
      const content = contentArea?.value.trim();
      const categoryEl = document.querySelector('input[name="category"]:checked');
      const category = categoryEl ? categoryEl.value : 'regionales';
      const author = document.getElementById('author')?.value;
      const publishedAt = dateInput?.value;
      const coverImage = coverImageInput?.value.trim();
      const excerpt = document.getElementById('excerpt')?.value.trim();
      const isFeatured = document.getElementById('isFeatured')?.checked;
      const isBreaking = document.getElementById('isBreaking')?.checked;

      if (!title || !content) return;

      try {
        if (btnPublish) {
          btnPublish.innerHTML = '<span>⏳ Guardando y publicando entrada...</span>';
          btnPublish.setAttribute('disabled', 'true');
        }

        if (alertBox) alertBox.classList.add('hidden');

        const res = await fetch('/api/admin/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            content,
            category,
            author,
            publishedAt,
            coverImage,
            excerpt,
            isFeatured,
            isBreaking,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (alertBox) {
            alertBox.className = 'mb-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-300';
            alertBox.innerHTML = `
              <div class="flex items-center gap-2">
                <span class="text-lg">✅</span>
                <div>
                  <strong>¡Entrada publicada con éxito!</strong>
                  <p class="text-xs mt-1 text-slate-300">
                    Tu artículo ya fue guardado en el repositorio y Vercel lo está desplegando. Podés verlo en vivo aquí:
                    <a href="/noticias/${data.slug}" target="_blank" class="text-emerald-400 underline font-mono ml-1">/noticias/${data.slug} ↗</a>
                  </p>
                </div>
              </div>
            `;
            alertBox.classList.remove('hidden');
          }

          // Reset form fields
          if (titleInput) titleInput.value = '';
          if (contentArea) contentArea.value = '';
          if (document.getElementById('excerpt')) document.getElementById('excerpt').value = '';
          if (coverImageInput) coverImageInput.value = '';
          if (imagePreview) imagePreview.src = '/images/posts/default-post.jpg';
          if (slugPreview) slugPreview.textContent = 'tu-noticia-aqui';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          if (alertBox) {
            alertBox.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-300';
            alertBox.innerHTML = `<strong>Error al publicar:</strong> ${data.error || 'Ocurrió un error inesperado'}`;
            alertBox.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (alertBox) {
          alertBox.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-300';
          alertBox.innerHTML = '<strong>Error de red:</strong> No se pudo conectar con el servidor.';
          alertBox.classList.remove('hidden');
        }
      } finally {
        if (btnPublish) {
          btnPublish.innerHTML = '<span>🚀 Publicar entrada</span>';
          btnPublish.removeAttribute('disabled');
        }
      }
    });
  </script>
</Layout>
