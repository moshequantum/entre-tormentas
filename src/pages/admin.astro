---
export const prerender = false;

import Layout from '../layouts/Layout.astro';

// Verify authenticated session
const sessionCookie = Astro.cookies.get('entretormentas_session');
if (!sessionCookie?.value) {
  return Astro.redirect('/login');
}
---

<Layout title="Mesa de Redacción | Entre Tormentas">
  <div class="min-h-screen bg-storm-950 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      
      <!-- Top Action Bar -->
      <header class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-storm-800 bg-storm-900/80 p-5 backdrop-blur-md">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-electric-600/20 text-electric-400 border border-electric-500/30">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <div>
            <h1 class="font-serif text-lg font-bold text-white">Mesa de Redacción</h1>
            <p class="text-xs text-slate-400">Entre Tormentas · Publicación en vivo</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 rounded-xl border border-storm-700 bg-storm-800/80 px-3.5 py-2 text-xs font-semibold text-slate-300 transition hover:border-slate-500 hover:text-white"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Ver Portal
          </a>

          <a
            href="/api/auth/logout"
            class="inline-flex items-center gap-1.5 rounded-xl border border-rose-500/30 bg-rose-500/10 px-3.5 py-2 text-xs font-semibold text-rose-300 transition hover:bg-rose-500/20"
          >
            Cerrar Sesión
          </a>
        </div>
      </header>

      <!-- Feedback Alert Box -->
      <div id="publish-alert" class="hidden mb-6 rounded-xl border p-4 text-sm font-medium"></div>

      <!-- Article Publishing Form -->
      <form id="form-article" class="space-y-6">
        
        <!-- Titular Principal -->
        <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-6 backdrop-blur-md">
          <label for="title" class="block font-serif text-sm font-bold text-white">
            Título de la Noticia <span class="text-rose-400">*</span>
          </label>
          <input
            id="title"
            name="title"
            type="text"
            required
            placeholder="Ej: Rosales inaugura nuevas obras de infraestructura en Maracaibo"
            class="mt-2 block w-full rounded-xl border border-storm-700 bg-storm-950 px-4 py-3 font-serif text-lg font-bold text-white placeholder-slate-600 focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
          />
          <div class="mt-2 flex items-center gap-2 text-[11px] font-mono text-slate-500">
            <span>Slug:</span>
            <span id="slug-preview" class="text-slate-400 truncate">tu-noticia-aqui</span>
          </div>
        </div>

        <!-- Metadatos: Categoría, Autor, Fecha -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          
          <!-- Categoría -->
          <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-5 backdrop-blur-md">
            <label for="category" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              Categoría <span class="text-rose-400">*</span>
            </label>
            <select
              id="category"
              name="category"
              required
              class="mt-2 block w-full rounded-xl border border-storm-700 bg-storm-950 px-3 py-2.5 text-sm font-medium text-white focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
            >
              <option value="regionales" selected>Regionales (Zulia)</option>
              <option value="deportes">Deportes</option>
              <option value="nacionales">Nacionales</option>
              <option value="sucesos">Sucesos</option>
              <option value="internacionales">Internacionales</option>
              <option value="espectaculos">Espectáculos</option>
              <option value="opinion">Opinión</option>
            </select>
          </div>

          <!-- Autor / Firma -->
          <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-5 backdrop-blur-md">
            <label for="author" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              Firma / Periodista
            </label>
            <input
              id="author"
              name="author"
              type="text"
              value="Redacción Entre Tormentas"
              class="mt-2 block w-full rounded-xl border border-storm-700 bg-storm-950 px-3 py-2.5 text-sm text-white focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
            />
          </div>

          <!-- Fecha de Publicación -->
          <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-5 backdrop-blur-md">
            <label for="publishedAt" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              Fecha de Publicación
            </label>
            <input
              id="publishedAt"
              name="publishedAt"
              type="date"
              class="mt-2 block w-full rounded-xl border border-storm-700 bg-storm-950 px-3 py-2.5 text-sm text-white focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
            />
          </div>
        </div>

        <!-- Imagen de Portada & Extracto -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          
          <!-- Imagen de Portada -->
          <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-5 backdrop-blur-md md:col-span-5">
            <label for="coverImage" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              URL Imagen de Portada
            </label>
            <input
              id="coverImage"
              name="coverImage"
              type="url"
              placeholder="https://pub-...r2.dev/foto.jpg"
              class="mt-2 block w-full rounded-xl border border-storm-700 bg-storm-950 px-3 py-2.5 text-xs text-white placeholder-slate-600 focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
            />
            <p class="mt-1 text-[11px] text-slate-500">
              Podés usar URLs de Cloudflare R2 o cualquier imagen externa.
            </p>

            <!-- Image Preview Box -->
            <div id="image-preview-container" class="mt-3 aspect-video w-full overflow-hidden rounded-xl border border-storm-800 bg-storm-950 flex items-center justify-center">
              <img id="image-preview" src="/images/posts/default-post.jpg" alt="Vista previa" class="h-full w-full object-cover" />
            </div>
          </div>

          <!-- Extracto / Bajada -->
          <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-5 backdrop-blur-md md:col-span-7 flex flex-col justify-between">
            <div>
              <label for="excerpt" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
                Bajada / Extracto Editorial
              </label>
              <textarea
                id="excerpt"
                name="excerpt"
                rows="4"
                placeholder="Resumen conciso del acontecimiento para los lectores y motores de búsqueda..."
                class="mt-2 block w-full rounded-xl border border-storm-700 bg-storm-950 p-3 text-sm text-white placeholder-slate-600 focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
              ></textarea>
            </div>

            <!-- Destacados Switches -->
            <div class="mt-4 flex flex-wrap gap-4 pt-3 border-t border-storm-800">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="isFeatured" name="isFeatured" class="h-4 w-4 rounded border-storm-700 bg-storm-950 text-electric-600 focus:ring-electric-500" />
                <span class="text-xs font-semibold text-slate-300">Destacada en Portada</span>
              </label>

              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="isBreaking" name="isBreaking" class="h-4 w-4 rounded border-storm-700 bg-storm-950 text-rose-600 focus:ring-rose-500" />
                <span class="text-xs font-semibold text-rose-300">Última Hora / Alerta</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Cuerpo de la Noticia (Editor) -->
        <div class="rounded-2xl border border-storm-800 bg-storm-900/50 p-6 backdrop-blur-md">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <label for="content" class="block font-serif text-sm font-bold text-white">
              Cuerpo de la Noticia <span class="text-rose-400">*</span>
            </label>

            <!-- Formatting Quick Buttons -->
            <div class="flex items-center gap-1 rounded-lg border border-storm-700 bg-storm-950 p-1 text-xs text-slate-400">
              <button type="button" class="btn-format rounded px-2 py-1 hover:bg-storm-800 hover:text-white" data-prefix="**" data-suffix="**" title="Negrita"><b>B</b></button>
              <button type="button" class="btn-format rounded px-2 py-1 hover:bg-storm-800 hover:text-white" data-prefix="*" data-suffix="*" title="Cursiva"><i>I</i></button>
              <button type="button" class="btn-format rounded px-2 py-1 hover:bg-storm-800 hover:text-white" data-prefix="## " data-suffix="" title="Subtítulo H2">H2</button>
              <button type="button" class="btn-format rounded px-2 py-1 hover:bg-storm-800 hover:text-white" data-prefix="> " data-suffix="" title="Cita textual">" "</button>
              <button type="button" class="btn-format rounded px-2 py-1 hover:bg-storm-800 hover:text-white" data-prefix="[" data-suffix="](url)" title="Enlace">🔗</button>
            </div>
          </div>

          <textarea
            id="content"
            name="content"
            required
            rows="12"
            placeholder="Escribí aquí el desarrollo de la noticia. Podés usar párrafos normales, subtítulos con ## o listas..."
            class="block w-full rounded-xl border border-storm-700 bg-storm-950 p-4 font-sans text-sm leading-relaxed text-slate-100 placeholder-slate-600 focus:border-electric-500 focus:outline-none focus:ring-1 focus:ring-electric-500"
          ></textarea>
        </div>

        <!-- Big Publish Action -->
        <div class="flex items-center justify-end gap-4 pt-4">
          <button
            type="submit"
            id="btn-publish"
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-electric-600 to-electric-500 px-8 py-4 font-serif text-base font-bold text-white shadow-xl shadow-electric-600/30 transition-all hover:scale-[1.02] hover:shadow-electric-500/40 active:scale-[0.98] focus:outline-none"
          >
            <span>🚀 Publicar Noticia en Vivo</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('form-article');
    const titleInput = document.getElementById('title');
    const slugPreview = document.getElementById('slug-preview');
    const coverImageInput = document.getElementById('coverImage');
    const imagePreview = document.getElementById('image-preview');
    const dateInput = document.getElementById('publishedAt');
    const alertBox = document.getElementById('publish-alert');
    const btnPublish = document.getElementById('btn-publish');
    const contentArea = document.getElementById('content');

    // Default to today
    if (dateInput) {
      dateInput.value = new Date().toISOString().split('T')[0];
    }

    // Slug generator preview
    function generateSlug(text) {
      return text
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    titleInput?.addEventListener('input', () => {
      const slug = generateSlug(titleInput.value);
      if (slugPreview) slugPreview.textContent = slug || 'tu-noticia-aqui';
    });

    // Image preview handler
    coverImageInput?.addEventListener('input', () => {
      const url = coverImageInput.value.trim();
      if (imagePreview) {
        imagePreview.src = url || '/images/posts/default-post.jpg';
      }
    });

    // Formatting buttons handler
    document.querySelectorAll('.btn-format').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!contentArea) return;
        const prefix = btn.getAttribute('data-prefix') || '';
        const suffix = btn.getAttribute('data-suffix') || '';
        const start = contentArea.selectionStart;
        const end = contentArea.selectionEnd;
        const selected = contentArea.value.substring(start, end);
        const replacement = prefix + (selected || 'texto') + suffix;
        contentArea.setRangeText(replacement, start, end, 'select');
        contentArea.focus();
      });
    });

    // Form submit handler
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const title = titleInput?.value.trim();
      const content = contentArea?.value.trim();
      const category = document.getElementById('category')?.value;
      const author = document.getElementById('author')?.value;
      const publishedAt = dateInput?.value;
      const coverImage = coverImageInput?.value.trim();
      const excerpt = document.getElementById('excerpt')?.value.trim();
      const isFeatured = document.getElementById('isFeatured')?.checked;
      const isBreaking = document.getElementById('isBreaking')?.checked;

      if (!title || !content) return;

      try {
        if (btnPublish) {
          btnPublish.innerHTML = '<span>⏳ Enviando y publicando en GitHub...</span>';
          btnPublish.setAttribute('disabled', 'true');
        }

        if (alertBox) alertBox.classList.add('hidden');

        const res = await fetch('/api/admin/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            content,
            category,
            author,
            publishedAt,
            coverImage,
            excerpt,
            isFeatured,
            isBreaking,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (alertBox) {
            alertBox.className = 'mb-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-300';
            alertBox.innerHTML = `
              <div class="flex items-center gap-2">
                <span class="text-lg">✅</span>
                <div>
                  <strong>¡Noticia publicada con éxito!</strong>
                  <p class="text-xs mt-1 text-slate-300">
                    Se envió directamente al repositorio. En unos 15 segundos estará visible en vivo en:
                    <a href="/noticias/${data.slug}" target="_blank" class="text-emerald-400 underline font-mono">/noticias/${data.slug}</a>
                  </p>
                </div>
              </div>
            `;
            alertBox.classList.remove('hidden');
          }

          // Reset form fields
          if (titleInput) titleInput.value = '';
          if (contentArea) contentArea.value = '';
          if (document.getElementById('excerpt')) document.getElementById('excerpt').value = '';
          if (coverImageInput) coverImageInput.value = '';
          if (imagePreview) imagePreview.src = '/images/posts/default-post.jpg';
          if (slugPreview) slugPreview.textContent = 'tu-noticia-aqui';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          if (alertBox) {
            alertBox.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-300';
            alertBox.innerHTML = `<strong>Error al publicar:</strong> ${data.error || 'Ocurrió un error inesperado'}`;
            alertBox.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (alertBox) {
          alertBox.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-300';
          alertBox.innerHTML = '<strong>Error de red:</strong> No se pudo conectar con el servidor.';
          alertBox.classList.remove('hidden');
        }
      } finally {
        if (btnPublish) {
          btnPublish.innerHTML = '<span>🚀 Publicar Noticia en Vivo</span>';
          btnPublish.removeAttribute('disabled');
        }
      }
    });
  </script>
</Layout>
